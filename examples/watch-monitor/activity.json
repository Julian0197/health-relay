{
  "schemaVersion": 1,
  "id": "00000000-0000-4000-8000-000000000003",
  "revision": 1,
  "name": "每日活动概览（示例）",
  "enabled": false,
  "device": "iPhone",
  "data": {
    "family": "quantity",
    "selections": [
      {
        "typeIdentifier": "HKQuantityTypeIdentifierRestingHeartRate",
        "sources": [],
        "unit": "count/min",
        "statistics": [
          "average"
        ]
      },
      {
        "typeIdentifier": "HKQuantityTypeIdentifierStepCount",
        "sources": [],
        "unit": "count",
        "statistics": [
          "sum"
        ]
      },
      {
        "typeIdentifier": "HKQuantityTypeIdentifierActiveEnergyBurned",
        "sources": [],
        "unit": "kcal",
        "statistics": [
          "sum"
        ]
      },
      {
        "typeIdentifier": "HKQuantityTypeIdentifierAppleExerciseTime",
        "sources": [],
        "unit": "min",
        "statistics": [
          "sum"
        ]
      },
      {
        "typeIdentifier": "HKQuantityTypeIdentifierDistanceWalkingRunning",
        "sources": [],
        "unit": "km",
        "statistics": [
          "sum"
        ]
      }
    ],
    "excludedSources": []
  },
  "range": {
    "mode": "defaultRange"
  },
  "export": {
    "format": "hea.v2",
    "mode": "aggregate",
    "grouping": "days",
    "statistics": [],
    "timeZone": "Asia/Shanghai",
    "deletionPolicy": "reject"
  },
  "destination": {
    "kind": "http",
    "url": "https://health.example.com/ingest/health",
    "method": "POST",
    "headers": {
      "X-HAE-Aggregation": "days"
    },
    "requiredSecretHeaders": [
      "X-API-Key"
    ],
    "timeoutSeconds": 30,
    "acknowledgement": "http2xx"
  },
  "execution": {
    "onDataChange": true,
    "onForeground": true,
    "periodicPolling": true,
    "minimumIntervalSeconds": 3600,
    "batchMaxRecords": 500,
    "batchMaxBytes": 1048576
  }
}
