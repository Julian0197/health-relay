    "requiredSecretHeaders": [
      "X-API-Key"
    ],
    "timeoutSeconds": 30,
    "acknowledgement": "http2xx"
  },
  "execution": {
    "onDataChange": true,
    "onForeground": true,
    "periodicPolling": true,
    "minimumIntervalSeconds": 1800,
    "batchMaxRecords": 500,
    "batchMaxBytes": 1048576
  }
