    "grouping": "minutes",
    "statistics": [],
    "timeZone": "Asia/Shanghai",
    "deletionPolicy": "reject"
  },
  "destination": {
    "kind": "http",
    "url": "https://health.example.com/ingest/hrv",
    "method": "POST",
    "headers": {
      "X-HAE-Aggregation": "minutes"
