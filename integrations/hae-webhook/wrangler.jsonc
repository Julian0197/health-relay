{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "healthrelay-health",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HEALTH_STORE",
        "class_name": "HealthStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HealthStore"
      ]
    }
  ],
  "vars": {
    "SIGNATURE_ENABLED": "false",
    "SIGNATURE_MODE": "health-indices-v1",
    "SIGNATURE_MIN_HISTORY_SAMPLES": "1"
  }
}
