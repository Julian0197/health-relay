+    assert(model.snapshot.exercise_minutes == HEALTH_MISSING && model.snapshot.distance_meters == HEALTH_MISSING);
+    for (size_t i = 0; i < HEALTH_TREND_DAYS; ++i) assert(model.snapshot.trend[i] == HEALTH_MISSING);
+    assert(!health_model_connected(&model, 0));
