+static void test_page_wrap_and_disconnect_retains_data(void) {
+    health_model_t model;
+    health_model_init(&model);
+    health_model_turn_page(&model, -1);
+    assert(model.page == HEALTH_PAGE_ACTIVITY);
+    health_model_turn_page(&model, 1);
+    assert(model.page == HEALTH_PAGE_OVERVIEW);
+    health_model_turn_page(&model, 1);
+    assert(model.page == HEALTH_PAGE_PRESSURE);
+    health_model_turn_page(&model, 0);
+    assert(model.page == HEALTH_PAGE_PRESSURE);
