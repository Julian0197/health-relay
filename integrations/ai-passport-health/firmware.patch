+static void assert_rejected_packet_mutation(const char *base, const char *needle, const char *replacement) {
+    char json[HEALTH_LINE_CAPACITY];
+    const char *start = strstr(base, needle);
+    assert(start);
+    size_t prefix = (size_t)(start - base);
+    memcpy(json, base, prefix);
+    snprintf(json + prefix, sizeof(json) - prefix, "%s%s", replacement, start + strlen(needle));
+    health_snapshot_t snapshot;
+    memset(&snapshot, 0x5a, sizeof(snapshot));
+    health_snapshot_t original = snapshot;
+    assert(!health_snapshot_parse(json, &snapshot));
+    assert(memcmp(&snapshot, &original, sizeof(snapshot)) == 0);
+}
+
+static void assert_rejected_mutation(const char *needle, const char *replacement) {
+    assert_rejected_packet_mutation(VALID, needle, replacement);
+}
