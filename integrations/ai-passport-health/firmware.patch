+static void test_daily_boundaries_and_atomic_rejection(void) {
+    assert_rejected_packet_mutation(DAILY, "\"day\":\"2026-10-21\"", "\"day\":\"\"");
+    assert_rejected_packet_mutation(DAILY, "\"day\":\"2026-10-21\"", "\"day\":\"2026-02-29\"");
