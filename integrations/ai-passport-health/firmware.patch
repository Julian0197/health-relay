index 0000000..4c057d6
--- /dev/null
+++ b/main/health_main.c
@@ -0,0 +1,499 @@
+/* Health values exist only in RAM; dedicated network credentials are stored in NVS. */
+#include "health_model.h"
+#include "health_network.h"
+#include "health_idle.h"
+#include "bsp_battery.h"
+#include "bsp_button.h"
+#include "bsp_display.h"
+#include "driver/usb_serial_jtag.h"
+#include "esp_log.h"
+#include "esp_lvgl_port.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+#include "lvgl.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#define COLOR_BG 0x101820
+#define COLOR_PANEL 0x1C2934
+#define COLOR_TEXT 0xF0F5F7
+#define COLOR_MUTED 0x9AABB8
+#define COLOR_ACCENT 0x65D5BB
+#define COLOR_WARNING 0xF5BB69
+#define COLOR_ERROR 0xF18D90
+#define COLOR_SLEEP_DEEP 0x8173DE
+#define COLOR_SLEEP_CORE 0x669EDB
+#define COLOR_SLEEP_REM 0x65D5BB
+#define COLOR_SLEEP_AWAKE 0xF5BB69
+#define COLOR_SLEEP_UNKNOWN 0x75838F
+#define INPUT_QUEUE_DEPTH 8
+
+static QueueHandle_t s_buttons;
+static lv_obj_t *s_screen;
+static lv_obj_t *s_clock_label, *s_date_label;
+static health_model_t s_model;
+static health_clock_t s_clock, s_last_sync;
+static health_line_t s_line;
+static bool s_usb_ready;
+static health_network_event_t s_network;
+static bool s_network_ready;
+static health_idle_t s_idle;
+typedef struct { bsp_btn_t button; bsp_btn_ev_t event; } health_button_event_t;
+
+static lv_obj_t *label(lv_obj_t *parent, int x, int y, int width,
+                       const char *text, const lv_font_t *font, unsigned color) {
+    lv_obj_t *obj = lv_label_create(parent);
+    lv_obj_set_pos(obj, x, y);
+    lv_obj_set_width(obj, width);
+    lv_label_set_long_mode(obj, LV_LABEL_LONG_CLIP);
+    lv_obj_set_style_text_font(obj, font, 0);
+    lv_obj_set_style_text_color(obj, lv_color_hex(color), 0);
+    lv_label_set_text(obj, text);
+    return obj;
+}
+
+static lv_obj_t *panel(int x, int y, int width, int height) {
+    lv_obj_t *obj = lv_obj_create(s_screen);
+    lv_obj_set_pos(obj, x, y);
+    lv_obj_set_size(obj, width, height);
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_pad_all(obj, 0, 0);
+    lv_obj_set_style_border_width(obj, 0, 0);
+    lv_obj_set_style_radius(obj, 10, 0);
+    lv_obj_set_style_bg_color(obj, lv_color_hex(COLOR_PANEL), 0);
+    return obj;
+}
+
+static const char *metric_text(int value, char *buffer, size_t size) {
+    if (value == HEALTH_MISSING) return "--";
+    snprintf(buffer, size, "%d", value);
+    return buffer;
+}
+
+static const char *time_text(const char *time) {
+    return time[0] ? time : "--";
+}
+
+static int today_sleep_score(const health_snapshot_t *data) {
+    return s_clock.valid && !strcmp(data->sleep_date, s_clock.date) ?
+        data->sleep_score : HEALTH_MISSING;
+}
+
+static void overview(const health_snapshot_t *data) {
+    char value[16], text[40];
+    lv_obj_t *card = panel(16, 99, 101, 84);
+    label(card, 8, 8, 88, "PRESSURE", &lv_font_montserrat_14, COLOR_MUTED);
+    label(card, 8, 30, 88, metric_text(data->pressure, value, sizeof(value)), &lv_font_montserrat_20, COLOR_ACCENT);
+    label(card, 8, 60, 88, time_text(data->pressure_at), &lv_font_montserrat_14,
+          data->retained ? COLOR_WARNING : COLOR_MUTED);
+
+    card = panel(123, 99, 101, 84);
+    label(card, 8, 8, 88, "SLEEP", &lv_font_montserrat_14, COLOR_MUTED);
+    if (data->sleep_minutes == HEALTH_MISSING) snprintf(text, sizeof(text), "--");
+    else snprintf(text, sizeof(text), "%dh%02dm", data->sleep_minutes / 60, data->sleep_minutes % 60);
+    label(card, 8, 30, 88, text, &lv_font_montserrat_20, COLOR_TEXT);
+    snprintf(text, sizeof(text), "Score %s", metric_text(today_sleep_score(data), value, sizeof(value)));
+    label(card, 8, 60, 88, text, &lv_font_montserrat_14, COLOR_MUTED);
+
+    card = panel(16, 191, 101, 84);
+    label(card, 8, 8, 88, "WORKOUT", &lv_font_montserrat_14, COLOR_MUTED);
+    if (data->workout_minutes == HEALTH_MISSING) snprintf(text, sizeof(text), "--");
+    else snprintf(text, sizeof(text), "%dh%02dm", data->workout_minutes / 60, data->workout_minutes % 60);
+    label(card, 8, 30, 88, text, &lv_font_montserrat_20, COLOR_TEXT);
+    snprintf(text, sizeof(text), "Count %s", metric_text(data->workout_count, value, sizeof(value)));
+    label(card, 8, 60, 88, text, &lv_font_montserrat_14, COLOR_MUTED);
+
+    card = panel(123, 191, 101, 84);
+    label(card, 8, 8, 88, "ACTIVITY", &lv_font_montserrat_14, COLOR_MUTED);
+    label(card, 8, 30, 88, metric_text(data->steps, value, sizeof(value)), &lv_font_montserrat_20, COLOR_TEXT);
+    label(card, 8, 60, 88, "steps", &lv_font_montserrat_14, COLOR_MUTED);
+}
+
+static void pressure_page(const health_snapshot_t *data) {
+    char value[16], text[64];
+    label(s_screen, 18, 97, 207, data->retained ? "LAST PRESSURE" : "PRESSURE", &lv_font_montserrat_20, COLOR_TEXT);
+    label(s_screen, 16, 121, 119, metric_text(data->pressure, value, sizeof(value)), &lv_font_montserrat_48, COLOR_ACCENT);
+    label(s_screen, 137, 149, 70, "/ 100", &lv_font_montserrat_14, COLOR_MUTED);
+    snprintf(text, sizeof(text), "Measured %s", time_text(data->pressure_at));
+    label(s_screen, 18, 176, 207, text, &lv_font_montserrat_14, COLOR_MUTED);
+    lv_obj_t *card = panel(16, 203, 101, 72);
+    label(card, 8, 5, 88, "HEART bpm", &lv_font_montserrat_14, COLOR_MUTED);
+    label(card, 8, 26, 88, metric_text(data->heart, value, sizeof(value)), &lv_font_montserrat_20, COLOR_TEXT);
+    label(card, 8, 52, 90, time_text(data->heart_at), &lv_font_montserrat_14, COLOR_MUTED);
+    card = panel(123, 203, 101, 72);
+    snprintf(text, sizeof(text), "%s ms", data->hrv_method[0] ? data->hrv_method : "HRV");
+    label(card, 8, 5, 88, text, &lv_font_montserrat_14, COLOR_MUTED);
+    label(card, 8, 26, 88, metric_text(data->hrv, value, sizeof(value)), &lv_font_montserrat_20, COLOR_TEXT);
+    label(card, 8, 52, 90, time_text(data->hrv_at), &lv_font_montserrat_14, COLOR_MUTED);
+}
+
+static void color_block(int x, int y, int width, int height, unsigned color) {
+    if (width <= 0) return;
+    lv_obj_t *obj = lv_obj_create(s_screen);
+    lv_obj_set_pos(obj, x, y);
+    lv_obj_set_size(obj, width, height);
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_border_width(obj, 0, 0);
+    lv_obj_set_style_radius(obj, 0, 0);
+    lv_obj_set_style_bg_color(obj, lv_color_hex(color), 0);
+    lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+}
+
+static void scrolling_text(int x, int y, int width, int height, const char *text, unsigned color) {
+    lv_obj_t *obj = label(s_screen, x, y, width, text, &lv_font_montserrat_14, color);
+    lv_obj_set_height(obj, height);
+    lv_label_set_long_mode(obj, LV_LABEL_LONG_SCROLL_CIRCULAR);
+    lv_obj_set_style_anim_duration(obj, 6000, 0);
+}
+
+static void sleep_page(const health_snapshot_t *data) {
+    char text[96], a[16], b[16], c[16];
+    label(s_screen, 18, 97, 110, "SLEEP 7D", &lv_font_montserrat_20, COLOR_TEXT);
+    snprintf(text, sizeof(text), "Today %s", metric_text(today_sleep_score(data), a, sizeof(a)));
+    label(s_screen, 128, 101, 98, text, &lv_font_montserrat_14, COLOR_ACCENT);
+    if (!data->has_sleep_week) {
+        if (data->sleep_minutes == HEALTH_MISSING) snprintf(text, sizeof(text), "-- duration");
+        else snprintf(text, sizeof(text), "%dh %02dm duration", data->sleep_minutes / 60, data->sleep_minutes % 60);
+        label(s_screen, 18, 154, 208, text, &lv_font_montserrat_20, COLOR_TEXT);
+        label(s_screen, 18, 192, 208, "Weekly data unavailable", &lv_font_montserrat_14, COLOR_MUTED);
+        label(s_screen, 18, 223, 208, time_text(data->sleep_date), &lv_font_montserrat_14, COLOR_MUTED);
+        return;
+    }
+    const unsigned colors[] = {COLOR_SLEEP_DEEP, COLOR_SLEEP_CORE, COLOR_SLEEP_REM,
+        COLOR_SLEEP_AWAKE, COLOR_SLEEP_UNKNOWN};
+    const char *names[] = {"Deep", "Core", "REM", "Awk", "Unk"};
+    const int legend_x[] = {18, 64, 106, 146, 186};
+    for (int i = 0; i < 5; ++i) {
+        int x = legend_x[i];
+        color_block(x, 126, 3, 7, colors[i]);
+        label(s_screen, x + 5, 122, i == 0 ? 40 : 34, names[i], &lv_font_montserrat_14, COLOR_MUTED);
+    }
+    int maximum = 600; /* Same scale for all seven nights, at least ten hours. */
+    for (int i = 0; i < HEALTH_TREND_DAYS; ++i) {
+        const health_sleep_day_t *night = &data->sleep_week[i];
+        int stages[] = {night->deep, night->core, night->rem, night->awake, night->unknown};
+        int sum = 0;
+        for (int stage = 0; stage < 5; ++stage) if (stages[stage] > 0) sum += stages[stage];
+        if (sum > maximum) maximum = sum;
+    }
+    for (int i = 0; i < HEALTH_TREND_DAYS; ++i) {
+        const health_sleep_day_t *night = &data->sleep_week[i];
+        int y = 142 + i * 15;
+        snprintf(text, sizeof(text), "%.2s/%.2s", night->date + 5, night->date + 8);
+        label(s_screen, 18, y - 2, 42, text, &lv_font_montserrat_14,
+              s_clock.valid && !strcmp(night->date, s_clock.date) ? COLOR_ACCENT : COLOR_MUTED);
+        color_block(64, y + 2, 112, 8, COLOR_PANEL);
+        if (night->total != HEALTH_MISSING) {
+            const int stages[] = {night->deep, night->core, night->rem, night->awake, night->unknown};
+            int sum = 0, previous = 0;
+            for (int stage = 0; stage < 5; ++stage) {
+                if (stages[stage] > 0) sum += stages[stage];
+                int edge = sum * 112 / maximum;
+                color_block(64 + previous, y + 2, edge - previous, 8, colors[stage]);
+                previous = edge;
+            }
+            snprintf(text, sizeof(text), "%dh%02d", night->total / 60, night->total % 60);
+        } else snprintf(text, sizeof(text), "--");
+        label(s_screen, 181, y - 2, 45, text, &lv_font_montserrat_14, COLOR_TEXT);
+    }
+    const health_sleep_day_t *last = &data->sleep_week[HEALTH_TREND_DAYS - 1];
+    snprintf(text, sizeof(text), "Deep %sm  Core %sm",
+        metric_text(last->deep, a, sizeof(a)), metric_text(last->core, b, sizeof(b)));
+    scrolling_text(18, 250, 208, 16, text, COLOR_TEXT);
+    snprintf(text, sizeof(text), "REM %sm  Awake %sm  Unk %sm",
+        metric_text(last->rem, a, sizeof(a)), metric_text(last->awake, b, sizeof(b)),
+        metric_text(last->unknown, c, sizeof(c)));
+    scrolling_text(18, 266, 208, 16, text, COLOR_TEXT);
+}
+
+static void metric_row(int y, const char *name, int value, const char *unit) {
+    char number[16], text[40];
+    label(s_screen, 18, y, 207, name, &lv_font_montserrat_14, COLOR_MUTED);
+    snprintf(text, sizeof(text), "%s %s", metric_text(value, number, sizeof(number)), unit);
+    label(s_screen, 18, y + 17, 207, text, &lv_font_montserrat_20, COLOR_TEXT);
+}
+
+static void workout_page(const health_snapshot_t *data) {
+    char text[512], count[16], minutes[16], energy[16];
+    label(s_screen, 18, 97, 207, "WORKOUT", &lv_font_montserrat_20, COLOR_TEXT);
+    snprintf(text, sizeof(text), "%s sessions   %s min", metric_text(data->workout_count, count, sizeof(count)),
+        metric_text(data->workout_minutes, minutes, sizeof(minutes)));
+    label(s_screen, 18, 126, 207, text, &lv_font_montserrat_14, COLOR_TEXT);
+    snprintf(text, sizeof(text), "Energy %s kcal", metric_text(data->workout_kcal, energy, sizeof(energy)));
+    label(s_screen, 18, 146, 207, text, &lv_font_montserrat_14, COLOR_MUTED);
+    label(s_screen, 18, 170, 207, "TYPES", &lv_font_montserrat_14, COLOR_MUTED);
+    size_t used = 0;
+    for (unsigned i = 0; i < data->workout_type_count; ++i) {
+        if (i) text[used++] = '\n';
+        int width = 0;
+        const char *type = data->workout_types[i];
+        for (size_t j = 0; type[j]; ++j) {
+            int advance = lv_font_get_glyph_width(&lv_font_montserrat_14,
+                (unsigned char)type[j], (unsigned char)type[j + 1]);
+            if (width + advance > 204) { text[used++] = '\n'; width = 0; }
+            text[used++] = type[j];
+            width += advance;
+        }
+    }
+    text[used] = '\0';
+    if (!used) snprintf(text, sizeof(text), "%s", data->workout_count == 0 ? "No workouts today" : "Type unavailable");
+    /* Overflow scrolls vertically through every type; names are never dropped. */
+    scrolling_text(18, 190, 207, 88, text, COLOR_ACCENT);
+}
+
+static void activity_page(const health_snapshot_t *data) {
+    char text[40];
+    label(s_screen, 18, 97, 207, "ACTIVITY", &lv_font_montserrat_20, COLOR_TEXT);
+    metric_row(124, "STEPS", data->steps, "steps");
+    metric_row(163, "ACTIVE ENERGY", data->active_kcal, "kcal");
+    metric_row(202, "EXERCISE", data->exercise_minutes, "min");
+    label(s_screen, 18, 241, 207, "DISTANCE", &lv_font_montserrat_14, COLOR_MUTED);
+    if (data->distance_meters == HEALTH_MISSING) snprintf(text, sizeof(text), "-- km");
+    else snprintf(text, sizeof(text), "%d.%02d km", data->distance_meters / 1000, data->distance_meters % 1000 / 10);
+    label(s_screen, 18, 260, 207, text, &lv_font_montserrat_20, COLOR_TEXT);
+}
+
+static const char *network_status(void) {
+    if (!s_network_ready) return "NETWORK UNAVAILABLE";
+    switch (s_network.status) {
+        case HEALTH_NET_STARTING: return "STARTING WI-FI";
+        case HEALTH_NET_NEEDS_ENDPOINT: return "USB SETUP REQUIRED";
+        case HEALTH_NET_NEEDS_WIFI: return "HOLD OK: WI-FI SETUP";
+        case HEALTH_NET_CONNECTING: return "CONNECTING WI-FI";
+        case HEALTH_NET_TIME_SYNC: return "SYNCING CLOCK";
+        case HEALTH_NET_FETCHING: return "UPDATING...";
+        case HEALTH_NET_ONLINE: return "WI-FI ONLINE";
+        case HEALTH_NET_WIFI_OFFLINE: return "WI-FI OFFLINE";
+        case HEALTH_NET_API_OFFLINE: return "API OFFLINE / LAST DATA";
+        case HEALTH_NET_SETUP: return "WI-FI SETUP / 5 MIN";
+        default: return "NETWORK ERROR";
+    }
+}
+
+static void setup_page(void) {
+    label(s_screen, 18, 92, 207, "1. Join this Wi-Fi", &lv_font_montserrat_14, COLOR_MUTED);
+    label(s_screen, 18, 115, 207, s_network.setup_ssid, &lv_font_montserrat_20, COLOR_ACCENT);
+    label(s_screen, 18, 151, 207, "Password", &lv_font_montserrat_14, COLOR_MUTED);
+    label(s_screen, 18, 173, 207, s_network.setup_password, &lv_font_montserrat_20, COLOR_TEXT);
+    label(s_screen, 18, 214, 207, "2. Open in browser", &lv_font_montserrat_14, COLOR_MUTED);
+    label(s_screen, 18, 237, 207, "http://192.168.4.1", &lv_font_montserrat_20, COLOR_ACCENT);
+    label(s_screen, 18, 272, 207, s_network.setup_failed ? "Failed; old Wi-Fi kept" : "3. Save home + hotspot",
+          &lv_font_montserrat_14, s_network.setup_failed ? COLOR_WARNING : COLOR_MUTED);
+}
+
+/* A clock tick changes only these two labels, never rebuilds health widgets. */
+static bool update_clock(void) {
+    if (!s_clock_label || !s_date_label || !bsp_lvgl_lock(100)) return false;
+    lv_label_set_text(s_clock_label, s_clock.time);
+    lv_label_set_text(s_date_label, s_clock.valid ? s_clock.date : "Clock not synced");
+    bsp_lvgl_unlock();
+    return true;
+}
+
+/* Only the worker calls render, and every LVGL operation is inside this lock. */
+static bool render(uint64_t now_ms, int battery) {
+    if (!bsp_lvgl_lock(500)) return false;
+    if (!s_screen) {
+        s_screen = lv_obj_create(NULL);
+        lv_obj_remove_flag(s_screen, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_style_bg_color(s_screen, lv_color_hex(COLOR_BG), 0);
+        lv_obj_set_style_bg_opa(s_screen, LV_OPA_COVER, 0);
+        lv_obj_set_style_border_width(s_screen, 0, 0);
+        lv_obj_set_style_pad_all(s_screen, 0, 0);
+        lv_screen_load(s_screen);
+    }
+    lv_obj_clean(s_screen);
+    char text[64];
+    s_clock_label = label(s_screen, 18, 8, 142, s_clock.time, &lv_font_montserrat_20, COLOR_TEXT);
+    s_date_label = label(s_screen, 18, 33, 140, s_clock.valid ? s_clock.date : "Clock not synced", &lv_font_montserrat_14, COLOR_MUTED);
+    if (s_model.snapshot.demo) label(s_screen, 167, 33, 55, "DEMO", &lv_font_montserrat_14, COLOR_WARNING);
+    if (battery < 0) snprintf(text, sizeof(text), "BAT --");
+    else snprintf(text, sizeof(text), "%d%%", battery);
+    lv_obj_t *battery_label = label(s_screen, 167, 12, 55, text, &lv_font_montserrat_14, COLOR_MUTED);
+    lv_obj_set_style_text_align(battery_label, LV_TEXT_ALIGN_RIGHT, 0);
+    bool connected = health_model_connected(&s_model, now_ms);
+    const char *status = network_status();
+    if (!s_network.endpoint_configured && connected) status = s_model.snapshot.online ? "USB CONNECTED" : "API OFFLINE";
+    label(s_screen, 18, 53, 207, status, &lv_font_montserrat_14,
+          s_network.status == HEALTH_NET_ONLINE ? COLOR_ACCENT : COLOR_WARNING);
+    const bool today = health_snapshot_is_today(&s_model.snapshot, &s_clock);
+    const char *day_label = !s_model.snapshot.day[0] ? "DATA DATE UNKNOWN" :
+        today ? "TODAY" : s_clock.valid ? "LAST DATA" : "DATA";
+    if (!s_model.snapshot.day[0]) snprintf(text, sizeof(text), "%s", day_label);
+    else if (today) snprintf(text, sizeof(text), "%s", day_label);
+    else snprintf(text, sizeof(text), "%s %s", day_label, s_model.snapshot.day);
+    label(s_screen, 18, 73, 207, text, &lv_font_montserrat_14, today ? COLOR_MUTED : COLOR_WARNING);
+    if (s_network.status == HEALTH_NET_SETUP) setup_page();
+    else switch (s_model.page) {
+        case HEALTH_PAGE_OVERVIEW: overview(&s_model.snapshot); break;
+        case HEALTH_PAGE_PRESSURE: pressure_page(&s_model.snapshot); break;
+        case HEALTH_PAGE_SLEEP: sleep_page(&s_model.snapshot); break;
+        case HEALTH_PAGE_WORKOUT: workout_page(&s_model.snapshot); break;
+        case HEALTH_PAGE_ACTIVITY: activity_page(&s_model.snapshot); break;
+        default: break;
+    }
+    if (s_network.status == HEALTH_NET_SETUP) snprintf(text, sizeof(text), "Setup closes in 5 minutes");
+    else {
+        snprintf(text, sizeof(text), "SYNC %.5s / 30m", s_last_sync.valid ? s_last_sync.time : "--:--");
+        label(s_screen, 18, 283, 207, text, &lv_font_montserrat_14, COLOR_MUTED);
+        snprintf(text, sizeof(text), "%d/5 UP/DOWN  OK: refresh", s_model.page + 1);
+    }
+    label(s_screen, 18, 301, 207, text, &lv_font_montserrat_14, COLOR_MUTED);
+    bsp_lvgl_unlock();
+    return true;
+}
+
+static bool display_refresh_paused(bool paused) {
+    if (!bsp_lvgl_lock(100)) return false;
+    esp_err_t result = paused ? lvgl_port_stop() : lvgl_port_resume();
+    bsp_lvgl_unlock();
+    /* BSP initialized this timer and the app never deinitializes it. These
+     * APIs set lv_timer_enable before operating on esp_timer; INVALID_STATE
+     * therefore means that timer is already stopped/running as requested. */
+    return result == ESP_OK || result == ESP_ERR_INVALID_STATE;
+}
+
+static void on_button(bsp_btn_t button, bsp_btn_ev_t event, void *user) {
+    (void)user;
+    health_button_event_t input = {.button = button, .event = event};
+    (void)xQueueSend(s_buttons, &input, 0);
+}
+
+static void health_worker(void *arg) {
+    (void)arg;
+    unsigned char bytes[128];
+    int battery = -1;
+    uint64_t next_battery_ms = 0;
+    bool dirty = true;
+    bool was_connected = false;
+    bool display_paused = false;
+    bool backlight_off = false;
+    for (;;) {
+        uint64_t now_ms = (uint64_t)(esp_timer_get_time() / 1000);
+        if (now_ms >= next_battery_ms) {
+            int reading = bsp_battery_soc();
+            if (reading != battery) dirty = true;
+            battery = reading;
+            next_battery_ms = now_ms + 10000;
+        }
+        health_network_event_t network;
+        while (health_network_poll(&network)) {
+            s_network = network;
+            if (network.configuration_ack && s_usb_ready) {
+                const char *ack = network.configuration_ok ? "{\"event\":\"configured\",\"ok\":true}\n" : "{\"event\":\"configured\",\"ok\":false}\n";
+                (void)usb_serial_jtag_write_bytes(ack, strlen(ack), pdMS_TO_TICKS(20));
+            }
+            if (network.has_snapshot) {
+                health_model_accept(&s_model, &network.snapshot, now_ms);
+                health_clock_format((int64_t)time(NULL), &s_last_sync);
+            }
+            dirty = true;
+        }
+        health_button_event_t input;
+        while (xQueueReceive(s_buttons, &input, 0) == pdTRUE) {
+            bool asleep_before = s_idle.asleep;
+            bool dispatch = health_idle_button(&s_idle, input.button, input.event, now_ms);
+            if (asleep_before && !s_idle.asleep) dirty = true;
+            if (!dispatch) continue;
+            if (input.event == BSP_BTN_LONG) {
+                if (input.button == BSP_BTN_OK) health_network_setup();
+                else if (input.button == BSP_BTN_UP) health_network_clear_wifi();
+            } else if (input.button == BSP_BTN_UP || input.button == BSP_BTN_DOWN) {
+                health_model_turn_page(&s_model, input.button == BSP_BTN_UP ? -1 : 1);
+                dirty = true;
+            } else if (input.button == BSP_BTN_OK && s_network.endpoint_configured) health_network_refresh();
+            else if (input.button == BSP_BTN_OK && s_usb_ready) {
+                static const char request[] = "{\"event\":\"refresh\"}\n";
+                (void)usb_serial_jtag_write_bytes(request, sizeof(request) - 1, pdMS_TO_TICKS(20));
+            }
+        }
+        int count = 0;
+        if (s_usb_ready) count = usb_serial_jtag_read_bytes(bytes, sizeof(bytes), pdMS_TO_TICKS(100));
+        else vTaskDelay(pdMS_TO_TICKS(100));
+        for (int i = 0; i < count; ++i) {
+            if (!health_line_push(&s_line, bytes[i])) continue;
+            health_snapshot_t snapshot;
+            health_endpoint_t endpoint;
+            if (health_endpoint_parse(s_line.data, &endpoint)) {
+                if (!health_network_configure(&endpoint)) {
+                    static const char fail[] = "{\"event\":\"configured\",\"ok\":false}\n";
+                    (void)usb_serial_jtag_write_bytes(fail, sizeof(fail) - 1, pdMS_TO_TICKS(20));
+                }
+                memset(&endpoint, 0, sizeof(endpoint));
+                memset(s_line.data, 0, sizeof(s_line.data));
+            } else if (!s_network.endpoint_configured && health_snapshot_parse(s_line.data, &snapshot)) {
+                now_ms = (uint64_t)(esp_timer_get_time() / 1000);
+                health_model_accept(&s_model, &snapshot, now_ms);
+                dirty = true;
+            }
+            memset(s_line.data, 0, sizeof(s_line.data));
+        }
+        now_ms = (uint64_t)(esp_timer_get_time() / 1000);
+        bool connected = health_model_connected(&s_model, now_ms);
+        if (connected != was_connected) dirty = true;
+        was_connected = connected;
+        health_clock_t clock;
+        health_clock_format((int64_t)time(NULL), &clock);
+        bool date_changed = clock.valid != s_clock.valid || strcmp(clock.date, s_clock.date) != 0;
+        bool clock_changed = strcmp(clock.time, s_clock.time) != 0 || date_changed;
+        s_clock = clock;
+        if (date_changed) dirty = true; /* Re-label retained data immediately at midnight. */
+        if (health_idle_update(&s_idle, now_ms, s_network.status == HEALTH_NET_SETUP)) {
+            if (!display_paused && display_refresh_paused(true)) {
+                display_paused = true;
+                bsp_display_backlight(0);
+                backlight_off = true;
+            }
+        } else {
+            if (display_paused && display_refresh_paused(false)) {
+                display_paused = false;
+                dirty = true;
+            }
+            if (!display_paused) {
+                if ((dirty || backlight_off) && render(now_ms, battery)) {
+                    dirty = false;
+                    /* Rebuild using the latest clock/model before lighting up. */
+                    if (backlight_off) {
+                        bsp_display_backlight(65);
+                        backlight_off = false;
+                    }
+                } else if (!backlight_off && clock_changed) (void)update_clock();
+            }
+        }
+        /* Allow idle/watchdog work even if a host continuously floods RX. */
+        vTaskDelay(pdMS_TO_TICKS(1));
+    }
+}
+
+void app_main(void) {
+    health_model_init(&s_model);
+    health_idle_init(&s_idle, (uint64_t)(esp_timer_get_time() / 1000));
+    health_clock_format((int64_t)time(NULL), &s_clock);
+    if (bsp_display_init() != ESP_OK || !bsp_lvgl_init()) return;
+    bsp_display_backlight(65);
+    (void)bsp_battery_init();
+    s_buttons = xQueueCreate(INPUT_QUEUE_DEPTH, sizeof(health_button_event_t));
+    if (!s_buttons) return;
+    usb_serial_jtag_driver_config_t usb = {
+        .rx_buffer_size = HEALTH_LINE_CAPACITY,
+        .tx_buffer_size = 256,
+    };
+    s_usb_ready = usb_serial_jtag_driver_install(&usb) == ESP_OK;
+    /* No protocol payload, credentials, or health content is ever logged. */
+    esp_log_level_set("*", ESP_LOG_WARN);
+    /* HTTP debug/error output may include URLs. The UI reports only safe states. */
+    esp_log_level_set("HTTP_CLIENT", ESP_LOG_NONE);
+    esp_log_level_set("esp-tls", ESP_LOG_NONE);
+    esp_log_level_set("mbedtls", ESP_LOG_NONE);
+    s_network_ready = health_network_start();
+    if (xTaskCreate(health_worker, "health_usb", 8192, NULL, 4, NULL) != pdPASS) {
+        ESP_LOGE("health", "USB worker allocation failed");
+        (void)render(0, -1);
+        return;
+    }
+    (void)bsp_button_init(on_button, NULL);
+}
diff --git a/main/health_model.c b/main/health_model.c
new file mode 100644
index 0000000..557646b
--- /dev/null
+++ b/main/health_model.c
@@ -0,0 +1,299 @@
+#define _POSIX_C_SOURCE 200809L
+#include "health_model.h"
+
+#include "cJSON.h"
+
+#include <string.h>
+#include <time.h>
+
+static void snapshot_init(health_snapshot_t *data) {
+    memset(data, 0, sizeof(*data));
+    data->pressure = data->heart = data->hrv = HEALTH_MISSING;
+    data->sleep_score = data->sleep_minutes = HEALTH_MISSING;
+    data->workout_count = data->workout_minutes = data->workout_kcal = HEALTH_MISSING;
+    data->steps = data->active_kcal = data->exercise_minutes = data->distance_meters = HEALTH_MISSING;
+    for (size_t i = 0; i < HEALTH_TREND_DAYS; ++i) data->trend[i] = HEALTH_MISSING;
+    for (size_t i = 0; i < HEALTH_TREND_DAYS; ++i) {
+        health_sleep_day_t *sleep = &data->sleep_week[i];
+        sleep->total = sleep->deep = sleep->core = sleep->rem = sleep->awake = sleep->unknown = HEALTH_MISSING;
+    }
+}
+
+void health_model_init(health_model_t *model) {
+    memset(model, 0, sizeof(*model));
+    snapshot_init(&model->snapshot);
+}
+
+void health_model_accept(health_model_t *model, const health_snapshot_t *snapshot,
+                         uint64_t now_ms) {
+    model->snapshot = *snapshot;
+    model->last_packet_ms = now_ms;
+    model->has_packet = true;
+}
+
+bool health_model_connected(const health_model_t *model, uint64_t now_ms) {
+    return model->has_packet && now_ms >= model->last_packet_ms &&
+           now_ms - model->last_packet_ms < HEALTH_DISCONNECT_MS;
+}
+
+void health_model_turn_page(health_model_t *model, int direction) {
+    if (direction > 0) model->page = (model->page + 1) % HEALTH_PAGE_COUNT;
+    if (direction < 0) model->page = (model->page + HEALTH_PAGE_COUNT - 1) % HEALTH_PAGE_COUNT;
+}
+
+bool health_line_push(health_line_t *line, unsigned char byte) {
+    if (byte == '\n') {
+        bool complete = !line->discarding && line->length > 0;
+        line->data[line->length] = '\0';
+        line->length = 0;
+        line->discarding = false;
+        line->carriage_return = false;
+        return complete;
+    }
+    if (line->discarding) return false;
+    if (byte == '\r' && !line->carriage_return && line->length < HEALTH_LINE_CAPACITY - 2) {
+        line->carriage_return = true;
+        return false;
+    }
+    /* Include the terminating newline in the protocol's <4096 byte limit. */
+    if (line->carriage_return || byte < 0x20 || byte > 0x7e ||
+        line->length >= HEALTH_LINE_CAPACITY - 2) {
+        line->discarding = true;
+        line->length = 0;
+        return false;
+    }
+    line->data[line->length++] = (char)byte;
+    return false;
+}
+
+/* Bound allocation and recursion before cJSON runs. V3 adds only seven sleep
+ * objects and eight workout names; protocol strings are ASCII without escapes. */
+static bool bounded_json(const char *json, size_t *length) {
+    if (!json) return false;
+    bool in_string = false;
+    unsigned depth = 0, commas = 0, colons = 0;
+    size_t i = 0;
+    for (; i <= HEALTH_LINE_CAPACITY - 2; ++i) {
+        unsigned char c = (unsigned char)json[i];
+        if (!c) break;
+        if (c < 0x20 || c > 0x7e || c == '\\') return false;
+        if (c == '"') { in_string = !in_string; continue; }
+        if (in_string) continue;
+        if (c == '{' || c == '[') {
+            if (++depth > 3) return false;
+        } else if (c == '}' || c == ']') {
+            if (!depth) return false;
+            --depth;
+        } else if (c == ',' && ++commas > 86) return false;
+        else if (c == ':' && ++colons > 75) return false;
+    }
+    if (i > HEALTH_LINE_CAPACITY - 2 || in_string || depth) return false;
+    *length = i;
+    return true;
+}
+
+static bool read_bool(const cJSON *root, const char *name, bool *output) {
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(root, name);
+    if (!cJSON_IsBool(value)) return false;
+    *output = cJSON_IsTrue(value);
+    return true;
+}
+
+static bool read_metric_value(const cJSON *value, int minimum, int maximum, int *output) {
+    if (cJSON_IsNull(value)) { *output = HEALTH_MISSING; return true; }
+    if (!cJSON_IsNumber(value) || !(value->valuedouble >= minimum && value->valuedouble <= maximum)) {
+        return false;
+    }
+    int number = (int)value->valuedouble;
+    if (value->valuedouble != number) return false;
+    *output = number;
+    return true;
+}
+
+static bool read_metric(const cJSON *root, const char *name, int minimum, int maximum, int *output) {
+    return read_metric_value(cJSON_GetObjectItemCaseSensitive(root, name), minimum, maximum, output);
+}
+
+static bool read_text(const cJSON *root, const char *name, char *output, size_t capacity) {
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(root, name);
+    if (!cJSON_IsString(value)) return false;
+    size_t length = strlen(value->valuestring);
+    if (length >= capacity) return false;
+    memcpy(output, value->valuestring, length + 1);
+    return true;
+}
+
+static bool digit(char c) { return c >= '0' && c <= '9'; }
+static int pair(const char *text) { return (text[0] - '0') * 10 + text[1] - '0'; }
+
+static bool timestamp_valid(const char *text) {
+    if (!text[0]) return true;
+    if (strlen(text) != 11 || text[2] != '/' || text[5] != ' ' || text[8] != ':') return false;
+    const int positions[] = {0, 1, 3, 4, 6, 7, 9, 10};
+    for (size_t i = 0; i < sizeof(positions) / sizeof(positions[0]); ++i) {
+        if (!digit(text[positions[i]])) return false;
+    }
+    return pair(text) >= 1 && pair(text) <= 12 && pair(text + 3) >= 1 &&
+           pair(text + 3) <= 31 && pair(text + 6) <= 23 && pair(text + 9) <= 59;
+}
+
+static bool date_valid(const char *text) {
+    if (!text[0]) return true;
+    if (strlen(text) != 10 || text[4] != '-' || text[7] != '-') return false;
+    for (int i = 0; i < 10; ++i) {
+        if (i != 4 && i != 7 && !digit(text[i])) return false;
+    }
+    int year = pair(text) * 100 + pair(text + 2);
+    int month = pair(text + 5), day = pair(text + 8);
+    if (year < 1 || month < 1 || month > 12) return false;
+    static const int days[] = {31,28,31,30,31,30,31,31,30,31,30,31};
+    int maximum = days[month - 1];
+    if (month == 2 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)) ++maximum;
+    return day >= 1 && day <= maximum;
+}
+
+static bool unique_keys(const cJSON *object) {
+    if (!cJSON_IsObject(object)) return false;
+    for (const cJSON *item = object->child; item; item = item->next) {
+        if (!item->string) return false;
+        for (const cJSON *prior = object->child; prior != item; prior = prior->next) {
+            if (!strcmp(prior->string, item->string)) return false;
+        }
+    }
+    return true;
+}
+
+static bool previous_date(char *date) {
+    int year = pair(date) * 100 + pair(date + 2);
+    int month = pair(date + 5), day = pair(date + 8);
+    if (--day == 0) {
+        if (--month == 0) { month = 12; --year; }
+        if (year < 1) return false;
+        static const int days[] = {31,28,31,30,31,30,31,31,30,31,30,31};
+        day = days[month - 1];
+        if (month == 2 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)) ++day;
+    }
+    /* Values originate in a validated 0001..9999 date and only decrease. */
+    date[0] = (char)('0' + year / 1000);
+    date[1] = (char)('0' + year / 100 % 10);
+    date[2] = (char)('0' + year / 10 % 10);
+    date[3] = (char)('0' + year % 10);
+    date[5] = (char)('0' + month / 10);
+    date[6] = (char)('0' + month % 10);
+    date[8] = (char)('0' + day / 10);
+    date[9] = (char)('0' + day % 10);
+    return true;
+}
+
+static bool read_sleep_week(const cJSON *root, health_snapshot_t *data) {
+    const cJSON *week = cJSON_GetObjectItemCaseSensitive(root, "sleepWeek");
+    if (!cJSON_IsArray(week) || cJSON_GetArraySize(week) != HEALTH_TREND_DAYS) return false;
+    char expected[HEALTH_DATE_CAPACITY];
+    memcpy(expected, data->day, sizeof(expected));
+    for (int i = HEALTH_TREND_DAYS - 1; i >= 0; --i) {
+        const cJSON *row = cJSON_GetArrayItem(week, i);
+        health_sleep_day_t *sleep = &data->sleep_week[i];
+        if (!unique_keys(row) || cJSON_GetArraySize(row) != 7 ||
+            !read_text(row, "date", sleep->date, sizeof(sleep->date)) || strcmp(sleep->date, expected) ||
+            !read_metric(row, "total", 0, 1440, &sleep->total) ||
+            !read_metric(row, "deep", 0, 1440, &sleep->deep) ||
+            !read_metric(row, "core", 0, 1440, &sleep->core) ||
+            !read_metric(row, "rem", 0, 1440, &sleep->rem) ||
+            !read_metric(row, "awake", 0, 1440, &sleep->awake) ||
+            !read_metric(row, "unknown", 0, 1440, &sleep->unknown)) return false;
+        if (sleep->total != HEALTH_MISSING && sleep->deep != HEALTH_MISSING &&
+            sleep->core != HEALTH_MISSING && sleep->rem != HEALTH_MISSING &&
+            sleep->unknown != HEALTH_MISSING &&
+            sleep->deep + sleep->core + sleep->rem + sleep->unknown != sleep->total) return false;
+        if (i && !previous_date(expected)) return false;
+    }
+    data->has_sleep_week = true;
+    return true;
+}
+
+static bool read_workout_types(const cJSON *root, health_snapshot_t *data) {
+    const cJSON *types = cJSON_GetObjectItemCaseSensitive(root, "workoutTypes");
+    if (!cJSON_IsArray(types) || cJSON_GetArraySize(types) > HEALTH_WORKOUT_TYPES) return false;
+    unsigned index = 0;
+    for (const cJSON *type = types->child; type; type = type->next) {
+        if (!cJSON_IsString(type)) return false;
+        size_t length = strlen(type->valuestring);
+        if (!length || length >= HEALTH_WORKOUT_TYPE_CAPACITY) return false;
+        for (size_t i = 0; i < length; ++i) {
+            unsigned char c = (unsigned char)type->valuestring[i];
+            if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+                (c >= '0' && c <= '9') || c == ' ' || c == '-')) return false;
+        }
+        for (unsigned prior = 0; prior < index; ++prior) {
+            if (!strcmp(data->workout_types[prior], type->valuestring)) return false;
+        }
+        memcpy(data->workout_types[index++], type->valuestring, length + 1);
+    }
+    data->workout_type_count = index;
+    return true;
+}
+
+void health_clock_format(int64_t utc_seconds, health_clock_t *output) {
+    *output = (health_clock_t){.time = "--:--:--"};
+    if (utc_seconds < 1704067200 || utc_seconds > 253402271999LL) return;
+    time_t local = (time_t)(utc_seconds + 8 * 60 * 60);
+    struct tm parts;
+    if (!gmtime_r(&local, &parts)) return;
+    if (strftime(output->time, sizeof(output->time), "%H:%M:%S", &parts) != 8 ||
+        strftime(output->date, sizeof(output->date), "%Y-%m-%d", &parts) != 10) {
+        *output = (health_clock_t){.time = "--:--:--"};
+        return;
+    }
+    output->valid = true;
+}
+
+bool health_snapshot_is_today(const health_snapshot_t *data, const health_clock_t *clock) {
+    return clock->valid && data->day[0] && !strcmp(data->day, clock->date);
+}
+
+bool health_snapshot_parse(const char *json, health_snapshot_t *output) {
+    size_t length;
+    if (!output || !bounded_json(json, &length)) return false;
+    cJSON *root = cJSON_ParseWithLengthOpts(json, length + 1, NULL, true);
+    if (!root) return false;
+    health_snapshot_t data;
+    snapshot_init(&data);
+    const cJSON *version = cJSON_GetObjectItemCaseSensitive(root, "v");
+    const cJSON *trend = cJSON_GetObjectItemCaseSensitive(root, "trend");
+    bool v2 = cJSON_IsNumber(version) && version->valuedouble == 2;
+    bool v3 = cJSON_IsNumber(version) && version->valuedouble == 3;
+    bool valid = unique_keys(root) && cJSON_GetArraySize(root) == (v3 ? 26 : v2 ? 24 : 16) &&
+        cJSON_IsNumber(version) && (version->valuedouble == 1 || v2 || v3) &&
+        read_bool(root, "online", &data.online) && read_bool(root, "demo", &data.demo) &&
+        read_bool(root, "retained", &data.retained) &&
+        read_metric(root, "pressure", 0, 100, &data.pressure) &&
+        read_metric(root, "heart", 1, 300, &data.heart) &&
+        read_metric(root, "hrv", 1, 1000, &data.hrv) &&
+        read_metric(root, "sleepScore", 0, 100, &data.sleep_score) &&
+        read_metric(root, "sleepMinutes", 0, 1440, &data.sleep_minutes) &&
+        read_text(root, "asOf", data.as_of, sizeof(data.as_of)) && timestamp_valid(data.as_of) &&
+        read_text(root, "pressureAt", data.pressure_at, sizeof(data.pressure_at)) && timestamp_valid(data.pressure_at) &&
+        read_text(root, "heartAt", data.heart_at, sizeof(data.heart_at)) && timestamp_valid(data.heart_at) &&
+        read_text(root, "hrvAt", data.hrv_at, sizeof(data.hrv_at)) && timestamp_valid(data.hrv_at) &&
+        read_text(root, "sleepDate", data.sleep_date, sizeof(data.sleep_date)) && date_valid(data.sleep_date) &&
+        read_text(root, "hrvMethod", data.hrv_method, sizeof(data.hrv_method)) &&
+        (strcmp(data.hrv_method, "RMSSD") == 0 || strcmp(data.hrv_method, "SDNN") == 0) &&
+        cJSON_IsArray(trend) && cJSON_GetArraySize(trend) == HEALTH_TREND_DAYS;
+    if (valid && (v2 || v3)) {
+        valid = read_text(root, "day", data.day, sizeof(data.day)) && data.day[0] && date_valid(data.day) &&
+            read_metric(root, "workoutCount", 0, 100, &data.workout_count) &&
+            read_metric(root, "workoutMinutes", 0, 1440, &data.workout_minutes) &&
+            read_metric(root, "workoutKcal", 0, 10000, &data.workout_kcal) &&
+            read_metric(root, "steps", 0, 200000, &data.steps) &&
+            read_metric(root, "activeKcal", 0, 20000, &data.active_kcal) &&
+            read_metric(root, "exerciseMinutes", 0, 1440, &data.exercise_minutes) &&
+            read_metric(root, "distanceMeters", 0, 2000000, &data.distance_meters);
+    }
+    for (int i = 0; valid && i < HEALTH_TREND_DAYS; ++i) {
+        valid = read_metric_value(cJSON_GetArrayItem(trend, i), 0, 100, &data.trend[i]);
+    }
+    if (valid && v3) valid = read_sleep_week(root, &data) && read_workout_types(root, &data);
+    cJSON_Delete(root);
+    if (valid) *output = data;
+    return valid;
+}
diff --git a/main/health_model.h b/main/health_model.h
new file mode 100644
index 0000000..ecb8a70
--- /dev/null
+++ b/main/health_model.h
@@ -0,0 +1,91 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define HEALTH_LINE_CAPACITY 4096
+#define HEALTH_TREND_DAYS 7
+#define HEALTH_TIMESTAMP_CAPACITY 12
+#define HEALTH_DATE_CAPACITY 11
+#define HEALTH_DISCONNECT_MS 45000
+#define HEALTH_MISSING (-1)
+#define HEALTH_WORKOUT_TYPES 8
+#define HEALTH_WORKOUT_TYPE_CAPACITY 25
+
+typedef struct {
+    char date[HEALTH_DATE_CAPACITY];
+    int total, deep, core, rem, awake, unknown;
+} health_sleep_day_t;
+
+typedef struct {
+    bool online;
+    bool demo;
+    bool retained;
+    char as_of[HEALTH_TIMESTAMP_CAPACITY];
+    int pressure;
+    char pressure_at[HEALTH_TIMESTAMP_CAPACITY];
+    int heart;
+    char heart_at[HEALTH_TIMESTAMP_CAPACITY];
+    int hrv;
+    char hrv_method[6];
+    char hrv_at[HEALTH_TIMESTAMP_CAPACITY];
+    int sleep_score;
+    int sleep_minutes;
+    char sleep_date[HEALTH_DATE_CAPACITY];
+    int trend[HEALTH_TREND_DAYS];
+    char day[HEALTH_DATE_CAPACITY];
+    int workout_count;
+    int workout_minutes;
+    int workout_kcal;
+    int steps;
+    int active_kcal;
+    int exercise_minutes;
+    int distance_meters;
+    bool has_sleep_week;
+    health_sleep_day_t sleep_week[HEALTH_TREND_DAYS];
+    unsigned workout_type_count;
+    char workout_types[HEALTH_WORKOUT_TYPES][HEALTH_WORKOUT_TYPE_CAPACITY];
+} health_snapshot_t;
+
+typedef struct {
+    char time[9];
+    char date[HEALTH_DATE_CAPACITY];
+    bool valid;
+} health_clock_t;
+
+typedef enum {
+    HEALTH_PAGE_OVERVIEW,
+    HEALTH_PAGE_PRESSURE,
+    HEALTH_PAGE_SLEEP,
+    HEALTH_PAGE_WORKOUT,
+    HEALTH_PAGE_ACTIVITY,
+    HEALTH_PAGE_COUNT,
+} health_page_t;
+
+typedef struct {
+    health_snapshot_t snapshot;
+    health_page_t page;
+    uint64_t last_packet_ms;
+    bool has_packet;
+} health_model_t;
+
+typedef struct {
+    char data[HEALTH_LINE_CAPACITY];
+    size_t length;
+    bool discarding;
+    bool carriage_return;
+} health_line_t;
+
+void health_model_init(health_model_t *model);
+void health_model_accept(health_model_t *model, const health_snapshot_t *snapshot,
+                         uint64_t now_ms);
+bool health_model_connected(const health_model_t *model, uint64_t now_ms);
+void health_model_turn_page(health_model_t *model, int direction);
+/* A complete line is valid until the next push; invalid/oversize lines are discarded. */
+bool health_line_push(health_line_t *line, unsigned char byte);
+/* Reject malformed packets atomically, leaving output unchanged on failure. */
+bool health_snapshot_parse(const char *json, health_snapshot_t *output);
+/* Fixed UTC+8 display, independent of the process/device timezone. */
+void health_clock_format(int64_t utc_seconds, health_clock_t *output);
+bool health_snapshot_is_today(const health_snapshot_t *data, const health_clock_t *clock);
diff --git a/main/health_network.c b/main/health_network.c
new file mode 100644
index 0000000..6e6de7f
--- /dev/null
+++ b/main/health_network.c
@@ -0,0 +1,419 @@
+/* Network/storage work stays here; only the UI worker owns LVGL and its model. */
+#include "health_network.h"
+#include "esp_crt_bundle.h"
+#include "esp_event.h"
+#include "esp_http_client.h"
+#include "esp_http_server.h"
+#include "esp_netif.h"
+#include "esp_random.h"
+#include "esp_sntp.h"
+#include "esp_timer.h"
+#include "esp_wifi.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+#include "nvs.h"
+#include "nvs_flash.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/socket.h>
+
+typedef enum { COMMAND_REFRESH, COMMAND_SETUP, COMMAND_CLEAR, COMMAND_ENDPOINT, COMMAND_PROFILES } command_kind_t;
+typedef struct {
+    command_kind_t kind;
+    union { health_endpoint_t endpoint; health_profiles_t profiles; } value;
+} network_command_t;
+
+static QueueHandle_t s_commands, s_events, s_acks, s_wifi_events;
+static health_endpoint_t s_endpoint;
+static health_profiles_t s_profiles;
+static nvs_handle_t s_nvs;
+static bool s_has_endpoint, s_has_ip, s_sntp_started, s_setup;
+static bool s_attempt_active;
+static esp_netif_t *s_sta_netif;
+static httpd_handle_t s_server;
+static health_network_event_t s_state;
+static char s_nonce[25];
+
+static uint64_t now_ms(void) { return (uint64_t)(esp_timer_get_time() / 1000); }
+
+static void publish(health_network_status_t status) {
+    s_state.status = status;
+    s_state.endpoint_configured = s_has_endpoint;
+    s_state.has_snapshot = false;
+    s_state.configuration_ack = false;
+    /* A one-slot latest state queue cannot back up network work behind the UI. */
+    (void)xQueueOverwrite(s_events, &s_state);
+}
+
+static void wifi_event(void *arg, esp_event_base_t base, int32_t id, void *data) {
+    (void)arg; (void)data;
+    int event = base == IP_EVENT && id == IP_EVENT_STA_GOT_IP ? 1 : 0;
+    (void)xQueueSend(s_wifi_events, &event, 0);
+}
+
+static bool load_blob(const char *key, void *output, size_t expected) {
+    size_t size = expected;
+    return nvs_get_blob(s_nvs, key, output, &size) == ESP_OK && size == expected;
+}
+
+static bool persist(const char *key, const void *data, size_t size) {
+    return nvs_set_blob(s_nvs, key, data, size) == ESP_OK && nvs_commit(s_nvs) == ESP_OK;
+}
+
+static bool stack_init(void) {
+    if (nvs_flash_init() != ESP_OK || nvs_open("healthwifi", NVS_READWRITE, &s_nvs) != ESP_OK) return false;
+    if (load_blob("endpoint", &s_endpoint, sizeof(s_endpoint)) &&
+        s_endpoint.url[sizeof(s_endpoint.url) - 1] == 0 && s_endpoint.token[sizeof(s_endpoint.token) - 1] == 0) {
+        s_has_endpoint = health_endpoint_valid(&s_endpoint);
+    }
+    if (!s_has_endpoint) memset(&s_endpoint, 0, sizeof(s_endpoint));
+    bool profiles_terminated = load_blob("profiles", &s_profiles, sizeof(s_profiles));
+    for (unsigned i = 0; i < HEALTH_PROFILE_COUNT; ++i) {
+        profiles_terminated = profiles_terminated && s_profiles.profile[i].ssid[32] == 0 && s_profiles.profile[i].password[63] == 0;
+    }
+    if (!profiles_terminated || !health_profiles_valid(&s_profiles)) memset(&s_profiles, 0, sizeof(s_profiles));
+    if (esp_netif_init() != ESP_OK || esp_event_loop_create_default() != ESP_OK) return false;
+    s_sta_netif = esp_netif_create_default_wifi_sta();
+    if (!s_sta_netif || !esp_netif_create_default_wifi_ap()) return false;
+    wifi_init_config_t config = WIFI_INIT_CONFIG_DEFAULT();
+    if (esp_wifi_init(&config) != ESP_OK || esp_wifi_set_storage(WIFI_STORAGE_RAM) != ESP_OK ||
+        esp_wifi_set_mode(WIFI_MODE_STA) != ESP_OK) return false;
+    if (esp_event_handler_register(WIFI_EVENT, WIFI_EVENT_STA_DISCONNECTED, wifi_event, NULL) != ESP_OK ||
+        esp_event_handler_register(IP_EVENT, IP_EVENT_STA_GOT_IP, wifi_event, NULL) != ESP_OK) return false;
+    return esp_wifi_start() == ESP_OK;
+}
+
+static esp_err_t form_page(httpd_req_t *request) {
+    const char *template = "<!doctype html><html><meta name=viewport content='width=device-width,initial-scale=1'>"
+        "<meta charset=utf-8><title>Health badge Wi-Fi</title><style>body{font:17px system-ui;max-width:420px;margin:24px auto;padding:12px}"
+        "input,button{box-sizing:border-box;width:100%%;font:inherit;padding:10px;margin:6px 0 18px}</style>"
+        "<h1>Health badge Wi-Fi</h1><p>Save up to two 2.4 GHz WPA2 networks. iPhone: enable Maximize Compatibility.</p>"
+        "<form method=post action=/save><input type=hidden name=nonce value='%s'>"
+        "<label>Home network<input name=ssid1 maxlength=32 required autocomplete=off></label>"
+        "<label>Password<input name=password1 type=password minlength=8 maxlength=63 required autocomplete=new-password></label>"
+        "<label>iPhone hotspot / second network (optional)<input name=ssid2 maxlength=32 autocomplete=off></label>"
+        "<label>Password<input name=password2 type=password minlength=8 maxlength=63 autocomplete=new-password></label>"
+        "<button>Save and connect</button></form><p>Existing passwords are never displayed. Hold UP on the badge to erase saved networks.</p></html>";
+    char *html = malloc(1800);
+    if (!html) return httpd_resp_send_err(request, HTTPD_500_INTERNAL_SERVER_ERROR, "Out of memory");
+    int length = snprintf(html, 1800, template, s_nonce);
+    httpd_resp_set_type(request, "text/html; charset=utf-8");
+    httpd_resp_set_hdr(request, "Cache-Control", "no-store");
+    httpd_resp_set_hdr(request, "Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'");
+    esp_err_t result = length > 0 && length < 1800 ? httpd_resp_send(request, html, length) : ESP_FAIL;
+    free(html);
+    return result;
+}
+
+static esp_err_t form_save(httpd_req_t *request) {
+    char body[HEALTH_FORM_CAPACITY + 40];
+    if (request->content_len == 0 || request->content_len >= sizeof(body))
+        return httpd_resp_send_err(request, HTTPD_400_BAD_REQUEST, "Invalid form");
+    size_t used = 0;
+    const uint64_t deadline = now_ms() + 8000;
+    while (used < request->content_len) {
+        if (now_ms() >= deadline) { memset(body, 0, sizeof(body)); return ESP_FAIL; }
+        int count = httpd_req_recv(request, body + used, request->content_len - used);
+        if (count <= 0) { memset(body, 0, sizeof(body)); return ESP_FAIL; }
+        used += (size_t)count;
+    }
+    body[used] = 0;
+    network_command_t command = {.kind = COMMAND_PROFILES};
+    bool valid = used > 31 && !strncmp(body, "nonce=", 6) && !memcmp(body + 6, s_nonce, 24) && body[30] == '&' &&
+        !memchr(body, 0, used) && health_profiles_parse(body + 31, &command.value.profiles);
+    memset(body, 0, sizeof(body));
+    if (!valid) return httpd_resp_send_err(request, HTTPD_400_BAD_REQUEST, "Enter distinct networks with passwords of 8-63 ASCII characters");
+    bool queued = xQueueSend(s_commands, &command, 0) == pdTRUE;
+    memset(&command, 0, sizeof(command));
+    if (!queued) {
+        httpd_resp_set_status(request, "503 Service Unavailable");
+        return httpd_resp_sendstr(request, "Try again");
+    }
+    httpd_resp_set_hdr(request, "Cache-Control", "no-store");
+    return httpd_resp_sendstr(request, "Wi-Fi details received. The badge will close this setup network and try both saved networks. Check its screen for the connection result.");
+}
+
+static void stop_setup(void) {
+    s_attempt_active = false;
+    if (s_server) { httpd_stop(s_server); s_server = NULL; }
+    (void)esp_wifi_stop();
+    (void)esp_wifi_set_mode(WIFI_MODE_STA);
+    (void)esp_wifi_start();
+    (void)xQueueReset(s_wifi_events);
+    s_setup = false;
+    s_has_ip = false;
+    memset(s_state.setup_ssid, 0, sizeof(s_state.setup_ssid));
+    memset(s_state.setup_password, 0, sizeof(s_state.setup_password));
+    memset(s_nonce, 0, sizeof(s_nonce));
+}
+
+static bool start_setup(void) {
+    if (s_setup) return true;
+    s_attempt_active = false;
+    (void)esp_wifi_disconnect();
+    (void)esp_wifi_stop();
+    s_has_ip = false;
+    wifi_config_t ap = {0};
+    uint32_t suffix = esp_random();
+    snprintf(s_state.setup_ssid, sizeof(s_state.setup_ssid), "Health-%04X", (unsigned)(suffix & 0xffff));
+    static const char alphabet[] = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+    for (unsigned i = 0; i < 12; ++i) s_state.setup_password[i] = alphabet[esp_random() % (sizeof(alphabet) - 1)];
+    s_state.setup_password[12] = 0;
+    for (unsigned i = 0; i < 12; ++i) snprintf(s_nonce + i * 2, 3, "%02x", (unsigned)(esp_random() & 0xff));
+    memcpy(ap.ap.ssid, s_state.setup_ssid, strlen(s_state.setup_ssid));
+    memcpy(ap.ap.password, s_state.setup_password, 12);
+    ap.ap.ssid_len = strlen(s_state.setup_ssid);
+    ap.ap.channel = 1;
+    ap.ap.authmode = WIFI_AUTH_WPA2_PSK;
+    ap.ap.max_connection = 1;
+    if (esp_wifi_set_mode(WIFI_MODE_AP) != ESP_OK || esp_wifi_set_config(WIFI_IF_AP, &ap) != ESP_OK || esp_wifi_start() != ESP_OK) goto fail;
+    (void)xQueueReset(s_wifi_events);
+    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
+    config.max_open_sockets = 2;
+    config.lru_purge_enable = true;
+    config.stack_size = 4096;
+    config.recv_wait_timeout = 5;
+    config.send_wait_timeout = 5;
+    if (httpd_start(&s_server, &config) != ESP_OK) goto fail;
+    const httpd_uri_t root = {.uri = "/", .method = HTTP_GET, .handler = form_page};
+    const httpd_uri_t save = {.uri = "/save", .method = HTTP_POST, .handler = form_save};
+    if (httpd_register_uri_handler(s_server, &root) != ESP_OK || httpd_register_uri_handler(s_server, &save) != ESP_OK) goto fail;
+    s_setup = true;
+    publish(HEALTH_NET_SETUP);
+    return true;
+fail:
+    stop_setup();
+    publish(HEALTH_NET_ERROR);
+    return false;
+}
+
+static bool clock_ready(void) {
+    if (!s_sntp_started) {
+        esp_sntp_setoperatingmode(SNTP_OPMODE_POLL);
+        esp_sntp_setservername(0, "time.cloudflare.com");
+        esp_sntp_setservername(1, "pool.ntp.org");
+        esp_sntp_init();
+        s_sntp_started = true;
+    }
+    /* Certificate validity is checked only after a plausible UTC time exists. */
+    return time(NULL) >= 1704067200;
+}
+
+static esp_err_t receive_http(esp_http_client_event_t *event) {
+    health_http_body_t *body = event->user_data;
+    bool within_budget = health_http_body_append(body, NULL, 0, now_ms());
+    if (within_budget && event->event_id == HTTP_EVENT_ON_DATA && event->data_len > 0)
+        within_budget = health_http_body_append(body, event->data, (size_t)event->data_len, now_ms());
+    if (!within_budget) {
+        /* Same worker/callback context: interrupt I/O without freeing client/TLS
+         * objects that the SDK's HTTP parser is still using. */
+        int socket = esp_http_client_get_socket(event->client);
+        if (socket >= 0) (void)shutdown(socket, SHUT_RDWR);
+    }
+    return ESP_OK;
+}
+
+static bool fetch_snapshot(health_snapshot_t *snapshot) {
+    health_http_body_t *body = malloc(sizeof(*body));
+    if (!body) return false;
+    health_http_body_init(body, now_ms());
+    esp_http_client_config_t config = {
+        .url = s_endpoint.url,
+        .crt_bundle_attach = esp_crt_bundle_attach,
+        .timeout_ms = 1000,
+        .is_async = true,
+        .event_handler = receive_http,
+        .user_data = body,
+        .disable_auto_redirect = true,
+        .buffer_size = 512,
+        .buffer_size_tx = 512,
+        .keep_alive_enable = false,
+    };
+    esp_http_client_handle_t client = esp_http_client_init(&config);
+    bool valid = false;
+    if (!client) goto done;
+    if (esp_http_client_set_header(client, "X-API-Key", s_endpoint.token) != ESP_OK ||
+        esp_http_client_set_header(client, "Accept", "application/json") != ESP_OK) goto done;
+    esp_err_t result = ESP_ERR_HTTP_EAGAIN;
+    while (!body->failed && now_ms() < body->deadline && result == ESP_ERR_HTTP_EAGAIN) {
+        result = esp_http_client_perform(client);
+        if (result == ESP_ERR_HTTP_EAGAIN) vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    /* This budget is checked between SDK steps and data/header events. DNS and
+     * SDK-internal header work retain their own timeout semantics; it is not a
+     * hard wall-clock bound on every internal SDK operation. */
+    valid = result == ESP_OK && health_http_body_complete(body,
+        esp_http_client_is_complete_data_received(client), esp_http_client_get_status_code(client), now_ms()) &&
+        health_snapshot_parse(body->data, snapshot);
+done:
+    if (client) esp_http_client_cleanup(client);
+    memset(body, 0, sizeof(*body));
+    free(body);
+    return valid;
+}
+
+static bool connect_profile(unsigned index) {
+    wifi_config_t config = {0};
+    const health_profile_t *profile = &s_profiles.profile[index];
+    memcpy(config.sta.ssid, profile->ssid, strlen(profile->ssid));
+    memcpy(config.sta.password, profile->password, strlen(profile->password));
+    config.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+    config.sta.pmf_cfg.capable = true;
+    config.sta.pmf_cfg.required = false;
+    s_attempt_active = false;
+    (void)esp_wifi_disconnect();
+    bool started = esp_wifi_set_config(WIFI_IF_STA, &config) == ESP_OK && esp_wifi_connect() == ESP_OK;
+    s_attempt_active = started;
+    memset(&config, 0, sizeof(config));
+    return started;
+}
+
+static bool current_connection_verified(unsigned index) {
+    if (index >= s_profiles.count) return false;
+    wifi_ap_record_t ap = {0};
+    esp_netif_ip_info_t ip = {0};
+    bool associated = esp_wifi_sta_get_ap_info(&ap) == ESP_OK;
+    bool has_ip = esp_netif_is_netif_up(s_sta_netif) &&
+        esp_netif_get_ip_info(s_sta_netif, &ip) == ESP_OK && ip.ip.addr != 0;
+    return health_connection_matches(&s_profiles.profile[index], s_attempt_active, associated, has_ip,
+                                     (const char *)ap.ssid, strnlen((const char *)ap.ssid, sizeof(ap.ssid)));
+}
+
+static void network_worker(void *arg) {
+    (void)arg;
+    if (!stack_init()) { publish(HEALTH_NET_ERROR); vTaskDelete(NULL); return; }
+    health_retry_t retry = {0};
+    health_refresh_t refresh = {0};
+    health_candidate_t candidate = {0};
+    uint64_t setup_deadline = 0, time_deadline = 0;
+    unsigned current_profile = 0;
+    bool manual = false;
+    publish(!s_has_endpoint ? HEALTH_NET_NEEDS_ENDPOINT : !s_profiles.count ? HEALTH_NET_NEEDS_WIFI : HEALTH_NET_CONNECTING);
+    for (;;) {
+        network_command_t command;
+        while (xQueueReceive(s_commands, &command, 0) == pdTRUE) {
+            if (command.kind == COMMAND_ENDPOINT) {
+                bool saved = persist("endpoint", &command.value.endpoint, sizeof(command.value.endpoint));
+                if (saved) { s_endpoint = command.value.endpoint; s_has_endpoint = true; refresh.fetched = false; }
+                s_state.endpoint_configured = s_has_endpoint;
+                s_state.has_snapshot = false;
+                s_state.configuration_ack = true;
+                s_state.configuration_ok = saved;
+                (void)xQueueOverwrite(s_acks, &s_state);
+                s_state.configuration_ack = false;
+            } else if (command.kind == COMMAND_CLEAR) {
+                health_candidate_rollback(&candidate, &s_profiles);
+                bool erased = nvs_erase_key(s_nvs, "profiles") == ESP_OK;
+                if (erased && nvs_commit(s_nvs) == ESP_OK) memset(&s_profiles, 0, sizeof(s_profiles));
+                else if (s_profiles.count) { publish(HEALTH_NET_ERROR); memset(&command, 0, sizeof(command)); continue; }
+                if (s_setup) stop_setup();
+                s_state.setup_failed = false;
+                if (start_setup()) setup_deadline = now_ms() + HEALTH_SETUP_TIMEOUT_MS;
+            } else if (command.kind == COMMAND_SETUP) {
+                health_candidate_rollback(&candidate, &s_profiles);
+                s_state.setup_failed = false;
+                if (start_setup()) setup_deadline = now_ms() + HEALTH_SETUP_TIMEOUT_MS;
+            } else if (command.kind == COMMAND_PROFILES) {
+                /* Keep old NVS profiles until a candidate actually obtains IP. */
+                if (health_candidate_begin(&candidate, &s_profiles, &command.value.profiles, now_ms())) {
+                    stop_setup();
+                    memset(&retry, 0, sizeof(retry));
+                    refresh.fetched = false;
+                } else publish(HEALTH_NET_ERROR);
+            } else if (command.kind == COMMAND_REFRESH) manual = true;
+            memset(&command, 0, sizeof(command));
+        }
+        uint64_t now = now_ms();
+        if (health_candidate_expire(&candidate, &s_profiles, now)) {
+            s_state.setup_failed = true;
+            if (start_setup()) setup_deadline = now + HEALTH_SETUP_TIMEOUT_MS;
+        }
+        if (s_setup) {
+            if (now >= setup_deadline) { stop_setup(); memset(&retry, 0, sizeof(retry)); }
+            else { vTaskDelay(pdMS_TO_TICKS(100)); continue; }
+        }
+        int wifi;
+        while (xQueueReceive(s_wifi_events, &wifi, 0) == pdTRUE) {
+            (void)wifi;
+            bool was_connected = s_has_ip;
+            /* Delayed GOT_IP/disconnect events can outlive a mode/profile switch.
+             * Query the current association and live netif rather than trusting
+             * the queued event as evidence for candidate credential persistence. */
+            s_has_ip = current_connection_verified(current_profile);
+            if (was_connected && !s_has_ip) publish(HEALTH_NET_WIFI_OFFLINE);
+            if (s_has_ip) {
+                if (candidate.pending) {
+                    if (persist("profiles", &s_profiles, sizeof(s_profiles))) health_candidate_commit(&candidate);
+                    else {
+                        health_candidate_rollback(&candidate, &s_profiles);
+                        s_state.setup_failed = true;
+                        if (start_setup()) setup_deadline = now + HEALTH_SETUP_TIMEOUT_MS;
+                        break;
+                    }
+                }
+                health_retry_connected(&retry, current_profile);
+                refresh.fetched = false;
+                time_deadline = now + 30000;
+            }
+        }
+        if (s_setup) { vTaskDelay(pdMS_TO_TICKS(100)); continue; }
+        if (!s_profiles.count) {
+            health_network_status_t status = s_has_endpoint ? HEALTH_NET_NEEDS_WIFI : HEALTH_NET_NEEDS_ENDPOINT;
+            if (s_state.status != status) publish(status);
+        }
+        else if (!s_has_ip) {
+            int index = health_retry_profile(&retry, s_profiles.count, now);
+            if (index >= 0) {
+                current_profile = (unsigned)index;
+                publish(connect_profile(current_profile) ? HEALTH_NET_CONNECTING : HEALTH_NET_WIFI_OFFLINE);
+            }
+        } else if (!s_has_endpoint) {
+            if (s_state.status != HEALTH_NET_NEEDS_ENDPOINT) publish(HEALTH_NET_NEEDS_ENDPOINT);
+        } else if (!clock_ready()) {
+            if (s_state.status != (now < time_deadline ? HEALTH_NET_TIME_SYNC : HEALTH_NET_API_OFFLINE))
+                publish(now < time_deadline ? HEALTH_NET_TIME_SYNC : HEALTH_NET_API_OFFLINE);
+        } else if (health_refresh_due(&refresh, now, manual)) {
+            manual = false;
+            publish(HEALTH_NET_FETCHING);
+            health_snapshot_t snapshot;
+            if (fetch_snapshot(&snapshot)) {
+                s_state.status = snapshot.online ? HEALTH_NET_ONLINE : HEALTH_NET_API_OFFLINE;
+                s_state.has_snapshot = true;
+                s_state.snapshot = snapshot;
+                (void)xQueueOverwrite(s_events, &s_state);
+            } else publish(HEALTH_NET_API_OFFLINE);
+        } else manual = false;
+        vTaskDelay(pdMS_TO_TICKS(100));
+    }
+}
+
+bool health_network_start(void) {
+    s_commands = xQueueCreate(3, sizeof(network_command_t));
+    s_events = xQueueCreate(1, sizeof(health_network_event_t));
+    s_acks = xQueueCreate(1, sizeof(health_network_event_t));
+    s_wifi_events = xQueueCreate(8, sizeof(int));
+    return s_commands && s_events && s_acks && s_wifi_events && xTaskCreate(network_worker, "health_net", 7168, NULL, 3, NULL) == pdPASS;
+}
+
+bool health_network_poll(health_network_event_t *event) {
+    return (s_acks && xQueueReceive(s_acks, event, 0) == pdTRUE) ||
+        (s_events && xQueueReceive(s_events, event, 0) == pdTRUE);
+}
+
+bool health_network_configure(const health_endpoint_t *endpoint) {
+    if (!s_commands || !health_endpoint_valid(endpoint)) return false;
+    network_command_t command = {.kind = COMMAND_ENDPOINT, .value.endpoint = *endpoint};
+    bool sent = xQueueSend(s_commands, &command, 0) == pdTRUE;
+    memset(&command, 0, sizeof(command));
+    return sent;
+}
+
+static void send_command(command_kind_t kind) {
+    if (s_commands) { network_command_t command = {.kind = kind}; (void)xQueueSend(s_commands, &command, 0); }
+}
+void health_network_refresh(void) { send_command(COMMAND_REFRESH); }
+void health_network_setup(void) { send_command(COMMAND_SETUP); }
+void health_network_clear_wifi(void) { send_command(COMMAND_CLEAR); }
diff --git a/main/health_network.h b/main/health_network.h
new file mode 100644
index 0000000..9acbee8
--- /dev/null
+++ b/main/health_network.h
@@ -0,0 +1,29 @@
+#pragma once
+#include "health_model.h"
+#include "health_network_model.h"
+
+typedef enum {
+    HEALTH_NET_STARTING, HEALTH_NET_NEEDS_ENDPOINT, HEALTH_NET_NEEDS_WIFI,
+    HEALTH_NET_CONNECTING, HEALTH_NET_TIME_SYNC, HEALTH_NET_FETCHING,
+    HEALTH_NET_ONLINE, HEALTH_NET_WIFI_OFFLINE, HEALTH_NET_API_OFFLINE,
+    HEALTH_NET_SETUP, HEALTH_NET_ERROR,
+} health_network_status_t;
+
+typedef struct {
+    health_network_status_t status;
+    bool endpoint_configured;
+    bool has_snapshot;
+    bool configuration_ack;
+    bool configuration_ok;
+    bool setup_failed;
+    health_snapshot_t snapshot;
+    char setup_ssid[24];
+    char setup_password[13];
+} health_network_event_t;
+
+bool health_network_start(void);
+bool health_network_poll(health_network_event_t *event);
+bool health_network_configure(const health_endpoint_t *endpoint);
+void health_network_refresh(void);
+void health_network_setup(void);
+void health_network_clear_wifi(void);
diff --git a/main/health_network_model.c b/main/health_network_model.c
new file mode 100644
index 0000000..bd2051b
--- /dev/null
+++ b/main/health_network_model.c
@@ -0,0 +1,226 @@
+#include "health_network_model.h"
+#include "cJSON.h"
+#include <string.h>
+
+static bool copy_text(const cJSON *object, const char *name, char *out, size_t capacity) {
+    const cJSON *item = cJSON_GetObjectItemCaseSensitive(object, name);
+    if (!cJSON_IsString(item) || strlen(item->valuestring) >= capacity) return false;
+    memcpy(out, item->valuestring, strlen(item->valuestring) + 1);
+    return true;
+}
+
+bool health_endpoint_valid(const health_endpoint_t *endpoint) {
+    const char *url = endpoint->url;
+    if (strncmp(url, "https://", 8) || strlen(url) < 15 || strlen(url) >= HEALTH_URL_CAPACITY) return false;
+    const char *path = strchr(url + 8, '/');
+    if (!path || path == url + 8) return false;
+    const char *port = memchr(url + 8, ':', (size_t)(path - url - 8));
+    const char *host_end = port ? port : path;
+    size_t label_length = 0;
+    for (const char *p = url + 8; p < host_end; ++p) {
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+              (*p >= '0' && *p <= '9') || *p == '.' || *p == '-')) return false;
+        if (*p == '.') {
+            if (!label_length || p[-1] == '-') return false;
+            label_length = 0;
+        } else if ((!label_length && *p == '-') || ++label_length > 63) return false;
+    }
+    if (!label_length || host_end[-1] == '-') return false;
+    unsigned number = 443;
+    if (port) {
+        number = 0;
+        if (port + 1 == path) return false;
+        for (const char *p = port + 1; p < path; ++p) {
+            if (*p < '0' || *p > '9' || number > 6553) return false;
+            number = number * 10 + (unsigned)(*p - '0');
+        }
+        if (!number || number > 65535) return false;
+    }
+    if (strcmp(path, "/badge")) {
+        static const char host[] = "magic.solutionsuite.cn";
+        static const char route[] = "/api/faas/";
+        if (number != 443 || (size_t)(host_end - url - 8) != sizeof(host) - 1 ||
+            memcmp(url + 8, host, sizeof(host) - 1) || strncmp(path, route, sizeof(route) - 1)) return false;
+        const char *id = path + sizeof(route) - 1;
+        if (!*id) return false;
+        for (const char *p = id; *p; ++p) {
+            if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+                  (*p >= '0' && *p <= '9') || *p == '_' || *p == '-')) return false;
+        }
+    }
+    size_t token_length = strlen(endpoint->token);
+    if (token_length < 16 || token_length >= HEALTH_TOKEN_CAPACITY) return false;
+    for (size_t i = 0; i < token_length; ++i) {
+        if ((unsigned char)endpoint->token[i] <= 0x20 || (unsigned char)endpoint->token[i] > 0x7e) return false;
+    }
+    return true;
+}
+
+bool health_endpoint_parse(const char *json, health_endpoint_t *output) {
+    if (!json || !output || strlen(json) > 512) return false;
+    /* The bootstrap only needs literal ASCII; reject escapes and nested tricks. */
+    bool in_string = false;
+    unsigned depth = 0;
+    for (const char *p = json; *p; ++p) {
+        if ((unsigned char)*p < 0x20 || (unsigned char)*p > 0x7e || *p == '\\') return false;
+        if (*p == '"') in_string = !in_string;
+        else if (!in_string) {
+            if (*p == '[' || *p == ']') return false;
+            if (*p == '{' && ++depth > 2) return false;
+            if (*p == '}') { if (!depth) return false; --depth; }
+        }
+    }
+    if (in_string || depth) return false;
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    if (!root) return false;
+    const cJSON *config = cJSON_GetObjectItemCaseSensitive(root, "configure");
+    health_endpoint_t endpoint = {0};
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 1 &&
+        cJSON_IsObject(config) && cJSON_GetArraySize(config) == 2 &&
+        copy_text(config, "url", endpoint.url, sizeof(endpoint.url)) &&
+        copy_text(config, "token", endpoint.token, sizeof(endpoint.token)) &&
+        health_endpoint_valid(&endpoint);
+    if (valid) *output = endpoint;
+    memset(&endpoint, 0, sizeof(endpoint));
+    cJSON_Delete(root);
+    return valid;
+}
+
+static int unhex(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static bool decode(const char *start, size_t length, char *output, size_t capacity) {
+    size_t used = 0;
+    for (size_t i = 0; i < length; ++i) {
+        unsigned char c = (unsigned char)start[i];
+        if (c == '+') c = ' ';
+        else if (c == '%') {
+            if (i + 2 >= length) return false;
+            int high = unhex(start[i + 1]), low = unhex(start[i + 2]);
+            if (high < 0 || low < 0) return false;
+            c = (unsigned char)(high * 16 + low);
+            i += 2;
+        }
+        if (c < 0x20 || c == 0x7f || used + 1 >= capacity) return false;
+        output[used++] = (char)c;
+    }
+    output[used] = '\0';
+    return true;
+}
+
+bool health_profiles_valid(const health_profiles_t *profiles) {
+    if (profiles->count < 1 || profiles->count > HEALTH_PROFILE_COUNT) return false;
+    for (unsigned i = 0; i < HEALTH_PROFILE_COUNT; ++i) {
+        size_t ssid = strlen(profiles->profile[i].ssid), password = strlen(profiles->profile[i].password);
+        if (i >= profiles->count) { if (ssid || password) return false; continue; }
+        if (!ssid || ssid > 32 || password < 8 || password > 63) return false;
+        for (size_t j = 0; j < ssid; ++j) if ((unsigned char)profiles->profile[i].ssid[j] < 0x20) return false;
+        for (size_t j = 0; j < password; ++j) {
+            unsigned char c = (unsigned char)profiles->profile[i].password[j];
+            if (c < 0x20 || c > 0x7e) return false;
+        }
+    }
+    return profiles->count != 2 || strcmp(profiles->profile[0].ssid, profiles->profile[1].ssid);
+}
+
+bool health_profiles_parse(const char *form, health_profiles_t *output) {
+    if (!form || !output || strlen(form) >= HEALTH_FORM_CAPACITY) return false;
+    const char *names[] = {"ssid1", "password1", "ssid2", "password2"};
+    health_profiles_t profiles = {0};
+    char *values[] = {profiles.profile[0].ssid, profiles.profile[0].password,
+                      profiles.profile[1].ssid, profiles.profile[1].password};
+    const size_t capacities[] = {33, 64, 33, 64};
+    unsigned seen = 0;
+    for (const char *p = form; *p;) {
+        const char *end = strchr(p, '&');
+        if (!end) end = p + strlen(p);
+        const char *equals = memchr(p, '=', (size_t)(end - p));
+        if (!equals) return false;
+        int index = -1;
+        for (int i = 0; i < 4; ++i) if ((size_t)(equals - p) == strlen(names[i]) && !strncmp(p, names[i], (size_t)(equals - p))) index = i;
+        if (index < 0 || (seen & (1u << index)) ||
+            !decode(equals + 1, (size_t)(end - equals - 1), values[index], capacities[index])) return false;
+        seen |= 1u << index;
+        p = *end ? end + 1 : end;
+    }
+    profiles.count = profiles.profile[1].ssid[0] ? 2 : 1;
+    bool valid = seen == 15 && health_profiles_valid(&profiles);
+    if (valid) *output = profiles;
+    memset(&profiles, 0, sizeof(profiles));
+    return valid;
+}
+
+int health_retry_profile(health_retry_t *retry, unsigned count, uint64_t now_ms) {
+    if (!count || count > HEALTH_PROFILE_COUNT || (retry->attempted && now_ms < retry->next_ms)) return -1;
+    unsigned profile = retry->next_profile % count;
+    retry->next_profile = (profile + 1) % count;
+    retry->next_ms = now_ms + HEALTH_CONNECT_TIMEOUT_MS;
+    retry->attempted = true;
+    return (int)profile;
+}
+
+void health_retry_connected(health_retry_t *retry, unsigned profile) {
+    retry->next_profile = profile;
+}
+
+bool health_refresh_due(health_refresh_t *refresh, uint64_t now_ms, bool manual) {
+    if (refresh->fetched && (now_ms < refresh->last_ms ||
+        now_ms - refresh->last_ms < (manual ? HEALTH_MANUAL_REFRESH_MS : HEALTH_POLL_MS))) return false;
+    refresh->last_ms = now_ms;
+    refresh->fetched = true;
+    return true;
+}
+
+bool health_candidate_begin(health_candidate_t *candidate, health_profiles_t *active,
+                            const health_profiles_t *replacement, uint64_t now_ms) {
+    if (candidate->pending || !health_profiles_valid(replacement)) return false;
+    candidate->previous = *active;
+    candidate->deadline = now_ms + HEALTH_CANDIDATE_TIMEOUT_MS;
+    candidate->pending = true;
+    *active = *replacement;
+    return true;
+}
+
+void health_candidate_commit(health_candidate_t *candidate) { memset(candidate, 0, sizeof(*candidate)); }
+
+void health_candidate_rollback(health_candidate_t *candidate, health_profiles_t *active) {
+    if (candidate->pending) *active = candidate->previous;
+    health_candidate_commit(candidate);
+}
+
+bool health_candidate_expire(health_candidate_t *candidate, health_profiles_t *active, uint64_t now_ms) {
+    if (!candidate->pending || now_ms < candidate->deadline) return false;
+    health_candidate_rollback(candidate, active);
+    return true;
+}
+
+bool health_connection_matches(const health_profile_t *profile, bool attempted,
+                               bool associated, bool has_ip, const char *ssid, size_t ssid_length) {
+    return attempted && associated && has_ip && ssid && ssid_length > 0 && ssid_length <= 32 &&
+        strlen(profile->ssid) == ssid_length && !memcmp(profile->ssid, ssid, ssid_length);
+}
+
+void health_http_body_init(health_http_body_t *body, uint64_t now_ms) {
+    memset(body, 0, sizeof(*body));
+    body->deadline = now_ms + HEALTH_HTTP_BUDGET_MS;
+}
+
+bool health_http_body_append(health_http_body_t *body, const char *data, size_t length, uint64_t now_ms) {
+    if (body->failed || now_ms >= body->deadline || length > sizeof(body->data) - 2 - body->length ||
+        (length && (!data || memchr(data, 0, length)))) {
+        body->failed = true;
+        return false;
+    }
+    if (length) memcpy(body->data + body->length, data, length);
+    body->length += length;
+    body->data[body->length] = 0;
+    return true;
+}
+
+bool health_http_body_complete(const health_http_body_t *body, bool complete, int status, uint64_t now_ms) {
+    return !body->failed && now_ms < body->deadline && body->length > 0 && complete && status == 200;
+}
