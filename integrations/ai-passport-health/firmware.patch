+    assert_rejected_packet_mutation(DAILY, "\"workoutCount\":2", "\"workoutCount\":-1");
+    assert_rejected_packet_mutation(DAILY, "\"workoutCount\":2,", "");
+    assert_rejected_packet_mutation(DAILY, "\"workoutMinutes\":53", "\"workoutMinutes\":1441");
+    assert_rejected_packet_mutation(DAILY, "\"workoutKcal\":340", "\"workoutKcal\":10001");
+    assert_rejected_packet_mutation(DAILY, "\"steps\":9876", "\"steps\":200001");
+    assert_rejected_packet_mutation(DAILY, "\"activeKcal\":620", "\"activeKcal\":20001");
+    assert_rejected_packet_mutation(DAILY, "\"exerciseMinutes\":61", "\"exerciseMinutes\":1441");
+    assert_rejected_packet_mutation(DAILY, "\"distanceMeters\":6532", "\"distanceMeters\":2000001");
+    assert_rejected_packet_mutation(DAILY, "\"distanceMeters\":6532", "\"distanceMeters\":0.5");
+    assert_rejected_packet_mutation(DAILY, "\"distanceMeters\":6532", "\"distanceMeters\":true");
+    assert_rejected_packet_mutation(DAILY, "\"day\":\"2026-10-21\"", "\"day\":\"2026-10-21\",\"day\":\"2026-10-21\"");
+    const char *nullable = "{\"v\":2,\"online\":false,\"demo\":false,\"asOf\":\"\","
+        "\"pressure\":null,\"retained\":false,\"pressureAt\":\"\",\"heart\":null,\"heartAt\":\"\","
+        "\"hrv\":null,\"hrvMethod\":\"SDNN\",\"hrvAt\":\"\",\"sleepScore\":null,"
+        "\"sleepMinutes\":null,\"sleepDate\":\"\",\"trend\":[null,null,null,null,null,null,null],"
+        "\"day\":\"2024-02-29\",\"workoutCount\":null,\"workoutMinutes\":null,\"workoutKcal\":null,"
+        "\"steps\":null,\"activeKcal\":null,\"exerciseMinutes\":null,\"distanceMeters\":null}";
+    health_snapshot_t data;
+    assert(health_snapshot_parse(nullable, &data));
+    assert(data.workout_count == HEALTH_MISSING && data.workout_minutes == HEALTH_MISSING);
+    assert(data.workout_kcal == HEALTH_MISSING && data.steps == HEALTH_MISSING);
+    assert(data.active_kcal == HEALTH_MISSING && data.exercise_minutes == HEALTH_MISSING);
+    assert(data.distance_meters == HEALTH_MISSING);
+    const char *zero = "{\"v\":2,\"online\":true,\"demo\":false,\"asOf\":\"\","
+        "\"pressure\":0,\"retained\":false,\"pressureAt\":\"\",\"heart\":null,\"heartAt\":\"\","
+        "\"hrv\":null,\"hrvMethod\":\"SDNN\",\"hrvAt\":\"\",\"sleepScore\":0,"
+        "\"sleepMinutes\":0,\"sleepDate\":\"2026-10-21\",\"trend\":[null,null,null,null,null,null,0],"
+        "\"day\":\"2026-10-21\",\"workoutCount\":0,\"workoutMinutes\":0,\"workoutKcal\":0,"
+        "\"steps\":0,\"activeKcal\":0,\"exerciseMinutes\":0,\"distanceMeters\":0}";
+    assert(health_snapshot_parse(zero, &data));
+    assert(data.pressure == 0 && data.sleep_score == 0 && data.sleep_minutes == 0);
+    assert(data.workout_count == 0 && data.workout_minutes == 0 && data.workout_kcal == 0);
+    assert(data.steps == 0 && data.active_kcal == 0 && data.exercise_minutes == 0 && data.distance_meters == 0);
+}
+
+static void test_invalid_packets_are_atomic(void) {
+    assert_rejected_mutation("\"v\":1", "\"v\":2");
+    assert_rejected_mutation("\"pressure\":36", "\"pressure\":101");
+    assert_rejected_mutation("\"pressure\":36", "\"pressure\":0.5");
+    assert_rejected_mutation("\"heart\":72", "\"heart\":0");
+    assert_rejected_mutation("\"hrv\":41", "\"hrv\":1001");
+    assert_rejected_mutation("\"sleepMinutes\":423", "\"sleepMinutes\":1441");
+    assert_rejected_mutation("\"online\":true", "\"online\":1");
+    assert_rejected_mutation("\"hrvMethod\":\"RMSSD\"", "\"hrvMethod\":\"UNKNOWN\"");
+    assert_rejected_mutation("[null,42,38,51,40,32,36]", "[1,2]");
+    assert_rejected_mutation("[null,42,38,51,40,32,36]", "[1,2,3,4,5,6,101]");
+    assert_rejected_mutation("\"asOf\":\"10/21 18:40\"", "\"asOf\":\"2026-10-21 18:40\"");
+    assert_rejected_mutation("\"asOf\":\"10/21 18:40\"", "\"asOf\":\"10/21 25:40\"");
+    assert_rejected_mutation("\"asOf\":\"10/21 18:40\"", "\"asOf\":\"\\u4e2d\"");
+    assert_rejected_mutation("\"heartAt\":\"10/21 18:40\",", "");
+    assert_rejected_mutation("\"v\":1", "\"v\":1,\"v\":1");
+    assert_rejected_mutation("\"v\":1", "\"v\":1,\"nested\":{}");
+    assert_rejected_mutation("\"v\":1", "\"v\":1,\"secret\":\"x\"");
+    assert_rejected_mutation("\"v\":1", "\"v\":1,\"v\\u0000x\":1");
+    health_snapshot_t snapshot;
+    assert(!health_snapshot_parse("{}x", &snapshot));
+    assert(!health_snapshot_parse("[]", &snapshot));
+}
+
+int main(void) {
+    test_initial_missing_values();
+    test_weekly_packet();
+    test_weekly_boundaries_and_atomic_rejection();
