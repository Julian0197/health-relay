+static void test_valid_nullable_packet(void) {
+    health_snapshot_t snapshot;
+    assert(health_snapshot_parse(VALID, &snapshot));
+    assert(snapshot.demo && snapshot.online && !snapshot.retained);
+    assert(snapshot.pressure == 36 && snapshot.heart == 72 && snapshot.hrv == 41);
+    assert(snapshot.sleep_score == 85 && snapshot.sleep_minutes == 423);
+    assert(snapshot.trend[0] == HEALTH_MISSING && snapshot.trend[6] == 36);
+    assert(strcmp(snapshot.hrv_method, "RMSSD") == 0);
+    assert(strcmp(snapshot.pressure_at, "10/21 18:30") == 0);
+    assert(!snapshot.day[0] && snapshot.workout_count == HEALTH_MISSING);
+    assert(snapshot.steps == HEALTH_MISSING && snapshot.distance_meters == HEALTH_MISSING);
+    const char *nullable = "{\"v\":1,\"online\":false,\"demo\":false,\"asOf\":\"\","
+        "\"pressure\":null,\"retained\":false,\"pressureAt\":\"\",\"heart\":null,\"heartAt\":\"\","
+        "\"hrv\":null,\"hrvMethod\":\"SDNN\",\"hrvAt\":\"\",\"sleepScore\":null,"
+        "\"sleepMinutes\":null,\"sleepDate\":\"\",\"trend\":[null,null,null,null,null,null,null]}";
+    assert(health_snapshot_parse(nullable, &snapshot));
+    assert(snapshot.pressure == HEALTH_MISSING && snapshot.heart == HEALTH_MISSING);
+    assert(snapshot.hrv == HEALTH_MISSING && snapshot.sleep_minutes == HEALTH_MISSING);
+    assert(!snapshot.online && !snapshot.demo);
+    assert(strcmp(snapshot.hrv_method, "SDNN") == 0);
+}
