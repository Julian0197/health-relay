+static void test_weekly_boundaries_and_atomic_rejection(void) {
+    assert_rejected_packet_mutation(WEEKLY, "\"v\":3", "\"v\":4");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63", "\"deep\":1441");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63", "\"deep\":-1");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63", "\"deep\":1.5");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63", "\"deep\":true");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63", "\"deep\":{}");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63", "\"deep\":62");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63", "\"deep\":63,\"deep\":63");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63,\"core\":240", "\"deep\":63,\"deep\":240");
+    assert_rejected_packet_mutation(WEEKLY, "\"deep\":63,\"core\":240", "\"deep\":63,\"extra\":240");
+    assert_rejected_packet_mutation(WEEKLY, "\"date\":\"2026-10-15\"", "\"date\":\"2026-02-30\"");
+    assert_rejected_packet_mutation(WEEKLY, "\"date\":\"2026-10-15\"", "\"date\":\"2026-10-14\"");
+    assert_rejected_packet_mutation(WEEKLY, "\"date\":\"2026-10-20\"", "\"date\":\"2026-10-21\"");
+    assert_rejected_packet_mutation(WEEKLY, "\"day\":\"2026-10-21\"", "\"day\":\"2026-10-22\"");
+    assert_rejected_packet_mutation(WEEKLY, "\"workoutTypes\":[\"Traditional strength\",\"Outdoor walk\"]", "\"workoutTypes\":null");
+    assert_rejected_packet_mutation(WEEKLY, "\"workoutTypes\":[\"Traditional strength\",\"Outdoor walk\"]", "\"workoutTypes\":[1]");
+    assert_rejected_packet_mutation(WEEKLY, "\"workoutTypes\":[\"Traditional strength\",\"Outdoor walk\"]", "\"workoutTypes\":[\"\"]");
+    assert_rejected_packet_mutation(WEEKLY, "Traditional strength", "1234567890123456789012345");
+    assert_rejected_packet_mutation(WEEKLY, "Traditional strength", "Walk/Run");
+    assert_rejected_packet_mutation(WEEKLY, "Traditional strength", "Walk_Run");
+    assert_rejected_packet_mutation(WEEKLY, "Traditional strength", "Walk+Run");
+    assert_rejected_packet_mutation(WEEKLY, "\"workoutTypes\":[\"Traditional strength\",\"Outdoor walk\"]", "\"workoutTypes\":[\"A\",\"B\",\"C\",\"D\",\"E\",\"F\",\"G\",\"H\",\"I\"]");
+    assert_rejected_packet_mutation(WEEKLY, "\"workoutTypes\":[\"Traditional strength\",\"Outdoor walk\"]", "\"workoutTypes\":[[\"A\"]]");
+    assert_rejected_packet_mutation(WEEKLY, "\"workoutTypes\":[\"Traditional strength\",\"Outdoor walk\"]", "\"workoutTypes\":[\"A\",\"A\"]");
+    assert_rejected_packet_mutation(WEEKLY,
+        "{\"date\":\"2026-10-15\",\"total\":null,\"deep\":null,\"core\":null,\"rem\":null,\"awake\":null,\"unknown\":null},", "");
+    assert_rejected_packet_mutation(WEEKLY, "\"sleepWeek\":[", "\"sleepWeek\":{");
+    assert_rejected_packet_mutation(WEEKLY, "\"online\":true,\"demo\":false", "\"online\":true,\"online\":false");
+    char json[HEALTH_LINE_CAPACITY];
+    const char *types = strstr(WEEKLY, "\"workoutTypes\":[");
+    assert(types);
+    size_t prefix = (size_t)(types - WEEKLY);
+    memcpy(json, WEEKLY, prefix);
+    snprintf(json + prefix, sizeof(json) - prefix,
+        "\"workoutTypes\":[\"123456789012345678901234\",\"B\",\"C\",\"D\",\"E\",\"F\",\"G\",\"H\"]}");
+    health_snapshot_t snapshot;
+    assert(health_snapshot_parse(json, &snapshot));
+    assert(snapshot.workout_type_count == 8 && strlen(snapshot.workout_types[0]) == 24);
+    snprintf(json + prefix, sizeof(json) - prefix, "\"workoutTypes\":[]}");
+    assert(health_snapshot_parse(json, &snapshot) && snapshot.workout_type_count == 0);
+    char padded[HEALTH_LINE_CAPACITY];
+    size_t length = strlen(WEEKLY);
+    memcpy(padded, WEEKLY, length);
+    memset(padded + length, ' ', HEALTH_LINE_CAPACITY - 2 - length);
+    padded[HEALTH_LINE_CAPACITY - 2] = '\0';
+    assert(health_snapshot_parse(padded, &snapshot));
+    health_snapshot_t original = snapshot;
+    padded[HEALTH_LINE_CAPACITY - 2] = ' ';
+    padded[HEALTH_LINE_CAPACITY - 1] = '\0';
+    assert(!health_snapshot_parse(padded, &snapshot));
+    assert(!memcmp(&original, &snapshot, sizeof(snapshot)));
+}
