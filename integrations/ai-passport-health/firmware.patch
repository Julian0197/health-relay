+static void test_week_dates_across_leap_and_year_boundaries(void) {
+    const char *dates[][HEALTH_TREND_DAYS] = {
+        {"2024-02-24", "2024-02-25", "2024-02-26", "2024-02-27", "2024-02-28", "2024-02-29", "2024-03-01"},
+        {"2026-12-26", "2026-12-27", "2026-12-28", "2026-12-29", "2026-12-30", "2026-12-31", "2027-01-01"},
+    };
+    for (size_t calendar = 0; calendar < sizeof(dates) / sizeof(dates[0]); ++calendar) {
+        char json[HEALTH_LINE_CAPACITY];
+        memcpy(json, DAILY, sizeof(DAILY));
+        json[5] = '3';
+        char *day = strstr(json, "\"day\":\"");
+        assert(day);
+        memcpy(day + 7, dates[calendar][6], 10);
+        size_t used = strlen(json) - 1;
+        used += (size_t)snprintf(json + used, sizeof(json) - used, ",\"sleepWeek\":[");
+        for (int i = 0; i < HEALTH_TREND_DAYS; ++i) {
+            used += (size_t)snprintf(json + used, sizeof(json) - used,
+                "%s{\"date\":\"%s\",\"total\":null,\"deep\":null,\"core\":null,\"rem\":null,\"awake\":null,\"unknown\":null}",
+                i ? "," : "", dates[calendar][i]);
+        }
+        snprintf(json + used, sizeof(json) - used, "],\"workoutTypes\":[]}");
+        health_snapshot_t snapshot;
+        assert(health_snapshot_parse(json, &snapshot));
+        assert(!strcmp(snapshot.sleep_week[0].date, dates[calendar][0]));
+    }
+}
