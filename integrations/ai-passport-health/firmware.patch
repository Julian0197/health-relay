diff --git a/main/health_idle.c b/main/health_idle.c
new file mode 100644
index 0000000..edecce7
--- /dev/null
+++ b/main/health_idle.c
@@ -0,0 +1,43 @@
+#include "health_idle.h"
+
+void health_idle_init(health_idle_t *idle, uint64_t now_ms) {
+    *idle = (health_idle_t){.last_activity_ms = now_ms};
+}
+
+bool health_idle_button(health_idle_t *idle, bsp_btn_t button, bsp_btn_ev_t event, uint64_t now_ms) {
+    if (button < BSP_BTN_UP || button > BSP_BTN_OK || event < BSP_BTN_PRESS || event > BSP_BTN_RELEASE) return false;
+    unsigned bit = 1u << (unsigned)button;
+    if (event == BSP_BTN_PRESS) {
+        idle->last_activity_ms = now_ms;
+        idle->held_buttons |= bit;
+        if (idle->asleep) {
+            idle->asleep = false;
+            idle->suppressed_buttons |= bit;
+        } else {
+            /* A new PRESS begins a new gesture, even if the preceding wake
+             * produced LONG or a delayed CLICK after its RELEASE. */
+            idle->suppressed_buttons &= ~bit;
+        }
+        return false;
+    }
+    if (idle->asleep) return false;
+    idle->last_activity_ms = now_ms;
+    if (event == BSP_BTN_RELEASE) {
+        idle->held_buttons &= ~bit;
+        /* Keep suppression until the next PRESS: CLICK arrives 180 ms later. */
+        return false;
+    }
+    return !(idle->suppressed_buttons & bit) &&
+        (event == BSP_BTN_CLICK || (event == BSP_BTN_LONG && (idle->held_buttons & bit)));
+}
+
+bool health_idle_update(health_idle_t *idle, uint64_t now_ms, bool setup_active) {
+    if (setup_active) {
+        idle->last_activity_ms = now_ms;
+        idle->asleep = false;
+    } else if (!idle->held_buttons && now_ms >= idle->last_activity_ms &&
+        now_ms - idle->last_activity_ms >= HEALTH_IDLE_TIMEOUT_MS) {
+        idle->asleep = true;
+    }
+    return idle->asleep;
+}
diff --git a/main/health_idle.h b/main/health_idle.h
new file mode 100644
index 0000000..9a0e5a3
--- /dev/null
+++ b/main/health_idle.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "bsp_button.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define HEALTH_IDLE_TIMEOUT_MS 60000
+
+typedef struct {
+    uint64_t last_activity_ms;
+    unsigned held_buttons;
+    unsigned suppressed_buttons;
+    bool asleep;
+} health_idle_t;
+
+void health_idle_init(health_idle_t *idle, uint64_t now_ms);
+/* Only CLICK/LONG for an ordinary gesture may reach application actions.
+ * The entire gesture that wakes the screen is consumed, including late CLICK. */
+bool health_idle_button(health_idle_t *idle, bsp_btn_t button, bsp_btn_ev_t event, uint64_t now_ms);
+/* SETUP keeps the display awake; background data never resets inactivity. */
+bool health_idle_update(health_idle_t *idle, uint64_t now_ms, bool setup_active);
diff --git a/main/health_main.c b/main/health_main.c
